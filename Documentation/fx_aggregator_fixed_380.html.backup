<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FX Aggregator - Fixed 380px Panels</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap');

        body {
            font-family: 'Inter', sans-serif;
            background-color: #0b0d10;
            color: #94a3b8;
            overflow: hidden;
            display: flex;
            justify-content: flex-start;
            align-items: flex-start;
            min-height: 100vh;
        }

        .mono {
            font-family: 'Inter', sans-serif;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 4px;
        }

        ::-webkit-scrollbar-track {
            background: #0f1115;
        }

        ::-webkit-scrollbar-thumb {
            background: #334155;
            border-radius: 2px;
        }

        /* --- ACTIVE PRICE TILES STYLING --- */
        .bg-tile-base {
            background: linear-gradient(to bottom, #16181d, #0f1114);
            transition: background 0.15s ease;
        }

        /* HOVER: Deep Muted Navy (Midnight Blue) */
        .hover-dark-mode:hover {
            background: linear-gradient(to bottom, #1e2536, #11151f) !important;
        }

        /* --- LADDER STYLING --- */
        .ladder-row:hover {
            background-color: #1e2536;
            cursor: pointer;
        }

        .ladder-col-mid {
            background-color: #0f1114;
        }

        /* --- BEST PRICE HIGHLIGHTS --- */
        .best-bid-cell {
            background: linear-gradient(to right, rgba(30, 58, 138, 0.2), transparent);
            border-left: 2px solid #3b82f6;
        }

        .best-offer-cell {
            background: linear-gradient(to left, rgba(30, 58, 138, 0.2), transparent);
            border-right: 2px solid #3b82f6;
        }

        /* --- UTILS --- */
        .hidden-force {
            display: none !important;
        }

        .fade-in {
            animation: fadeIn 0.3s ease-in-out;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(5px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* --- TOOLTIP STYLING --- */
        .trade-tooltip {
            position: absolute;
            top: 100%;
            left: 50%;
            transform: translateX(-50%);
            margin-top: 8px;
            background: linear-gradient(to bottom, #0f1318, #0a0d11);
            border: 1px solid #1e3a5f;
            border-radius: 4px;
            padding: 12px 16px;
            z-index: 1000;
            min-width: 280px;
            max-width: 360px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.6);
            pointer-events: none;
            opacity: 0;
            transition: opacity 0.2s ease-in-out;
        }

        .trade-tooltip.visible {
            opacity: 1;
        }

        .tooltip-section {
            margin-bottom: 8px;
        }

        .tooltip-section:last-child {
            margin-bottom: 0;
        }

        .tooltip-label {
            font-size: 9px;
            color: #64748b;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 3px;
        }

        .tooltip-value {
            font-size: 11px;
            color: #e2e8f0;
            font-weight: 500;
        }

        .tooltip-highlight {
            color: #60a5fa;
            font-weight: 600;
        }

        .tooltip-divider {
            height: 1px;
            background: #1e293b;
            margin: 8px 0;
        }

        /* --- TRADE CLICK EFFECTS --- */
        /* Flash Effect - Entire tile flashes with inner glow */
        .trade-tile {
            position: relative;
            overflow: hidden;
        }

        /* Flash animation for bid - using blue for consistency */
        .trade-flash-bid {
            animation: flash-bid 0.75s ease-out;
        }

        @keyframes flash-bid {
            0% {
                background: linear-gradient(to bottom, #16181d, #0f1114);
                box-shadow: inset 0 0 0 0 rgba(59, 130, 246, 0);
            }

            20% {
                background: linear-gradient(to bottom, #152040, #0d1530);
                box-shadow: inset 0 0 150px rgba(59, 130, 246, 0.5);
            }

            100% {
                background: linear-gradient(to bottom, #16181d, #0f1114);
                box-shadow: inset 0 0 0 0 rgba(59, 130, 246, 0);
            }
        }

        /* Flash animation for offer - deep blue inner glow */
        .trade-flash-offer {
            animation: flash-offer 0.75s ease-out;
        }

        @keyframes flash-offer {
            0% {
                background: linear-gradient(to bottom, #16181d, #0f1114);
                box-shadow: inset 0 0 0 0 rgba(59, 130, 246, 0);
            }

            20% {
                background: linear-gradient(to bottom, #152040, #0d1530);
                box-shadow: inset 0 0 150px rgba(59, 130, 246, 0.5);
            }

            100% {
                background: linear-gradient(to bottom, #16181d, #0f1114);
                box-shadow: inset 0 0 0 0 rgba(59, 130, 246, 0);
            }
        }

        /* Urgent pulsing animation for low timeout */
        .pulse-urgent {
            animation: pulse-urgent 1s ease-in-out infinite;
        }

        @keyframes pulse-urgent {

            0%,
            100% {
                opacity: 1;
                transform: scale(1);
            }

            50% {
                opacity: 0.7;
                transform: scale(1.02);
            }
        }

        /* Hide success indicator */
        .success-indicator {
            display: none;
        }

        /* LP Checkbox Styling */
        .lp-checkbox {
            width: 14px;
            height: 14px;
            margin-top: 4px;
            accent-color: #3b82f6;
        }

        /* Ensure checkbox stays visible when LP is disabled */
        .lp-disabled .lp-checkbox {
            opacity: 1 !important;
        }

        /* LP Timer Styling */
        .lp-timer {
            font-size: 10px;
            font-weight: 600;
            margin-top: 2px;
            transition: color 0.3s ease;
        }

        .timer-fresh {
            color: #10b981;
            /* Green - fresh quote */
        }

        .timer-warning {
            color: #f59e0b;
            /* Amber - quote aging */
            animation: pulse-warning 2s ease-in-out infinite;
        }

        .timer-urgent {
            color: #ef4444;
            /* Red - quote expiring soon */
            animation: pulse-urgent 1s ease-in-out infinite;
        }

        .timer-expired {
            color: #64748b;
            /* Gray - quote expired */
        }

        @keyframes pulse-warning {
            0%,
            100% {
                opacity: 1;
            }

            50% {
                opacity: 0.7;
            }
        }

        /* Quote staleness opacity levels */
        .quote-fresh {
            opacity: 1.0;
        }

        .quote-aging {
            opacity: 0.85;
        }

        .quote-stale {
            opacity: 0.6;
        }

        .quote-expired {
            opacity: 0.35;
        }

        /* Visual Staleness Summary:
         * 
          * FRESH (90s+): 
                *   - Timer: Green text (.timer-fresh)
         * - Row: Full opacity (1.0)
           *   - Behavior: Normal trading, full confidence
         * 
           * AGING (30-90s):
             *   - Timer: Amber text (.timer-warning) with slow pulse
             *   - Row: Slightly faded (0.85)
              *   - Behavior: Quote aging, consider refreshing
         * 
        * URGENT (<10s):
                *   - Timer: Red text (.timer-urgent) with fast pulse
        *   - Row: Faded (0.6)
            *   - Behavior: Quote expiring soon, high urgency
          * 
        * EXPIRED (0s):
                *   - Timer: "EXPIRED" in gray (.timer-expired)
        *   - Row: Very faded (0.35)
        *   - Behavior: Quote invalid, requires new RFQ
          */
    </style>
</head>

<body>

    <!-- PERSISTENT DEALS HANDLE -->
    <div class="deals-tab-handle" onclick="toggleDealsPanel()" title="Open Deals Panel">
        <span>◀</span>
        <span>DEALS</span>
    </div>

    <!-- MAIN CONTAINER - Flexible width for horizontal scrolling -->
    <div class="h-screen flex flex-col p-2 max-w-full overflow-x-auto">

        <!-- PANELS CONTAINER - Multiple 400px leg panels + 380px deal cards -->
        <div class="flex gap-5 h-full">

            <!-- LEG PANELS CONTAINER - Can contain multiple 400px panels -->
            <div id="leg-panels-container" class="flex gap-5 flex-shrink-0">

                <!-- LEG 1 PANEL - 400px -->
                <div id="leg1-panel" class="w-[400px] flex flex-col relative flex-shrink-0">

                    <!-- UNIFIED PRICING PANEL - Starts in RFQ state, transitions to prices on click -->
                    <div id="active-panel" class="flex-col h-full fade-in">

                        <!-- NATURAL LANGUAGE INPUT -->
                        <div class="mb-1">
                            <div class="relative">
                                <input type="text" id="trade-input" placeholder="E.g., buy 10M EURUSD 1M call 1.18"
                                    class="w-full bg-[#0f1114] border border-[#1e293b] rounded px-3 py-2 text-sm text-white placeholder-slate-600 focus:outline-none focus:border-blue-500/50 focus:ring-1 focus:ring-blue-500/30 transition-all"
                                    onkeypress="if(event.key === 'Enter') parseTradeInput()" />
                                <button onclick="parseTradeInput()"
                                    class="absolute right-2 top-1/2 -translate-y-1/2 px-3 py-1 bg-blue-600/20 hover:bg-blue-600/30 text-blue-400 text-xs font-medium rounded transition-colors">
                                    Parse
                                </button>
                            </div>
                            <div id="parse-feedback" class="mt-0.5 text-xs min-h-0"></div>
                        </div>

                        <!-- EXECUTION TILES -->
                        <div class="flex h-48 w-full mb-1 gap-0.5 relative">

                            <!-- BID SIDE -->
                            <div id="bid-tile" onclick="startRFQ()"
                                class="trade-tile flex-1 bg-tile-base hover-dark-mode rounded-l p-4 flex flex-col relative overflow-hidden group cursor-pointer border border-[#1e293b]">
                                <div class="success-indicator bg-green-500/20 text-green-400" id="bid-success">✓</div>
                                <div id="bid-label-container"
                                    class="flex justify-start items-start w-full absolute top-4 left-0 px-4 invisible">
                                    <span id="bid-label" class="text-xs font-bold text-green-500 tracking-widest">BID
                                        (VOL)</span>
                                </div>
                                <div class="flex-1 flex flex-col justify-center items-center">
                                    <span id="bid-rfq-label"
                                        class="text-[10px] text-slate-500 font-bold tracking-wider mb-1">CLICK TO RFQ
                                        (F9)</span>
                                    <div id="bid-value"
                                        class="text-slate-600 group-hover:text-white transition-colors duration-200 text-7xl font-bold tracking-tighter h-20 flex items-center">
                                        RFQ</div>
                                    <div id="bid-secondary"
                                        class="text-sm font-bold text-slate-700 mt-2 font-mono tracking-wide group-hover:text-slate-400 transition-colors invisible">
                                        ---</div>
                                </div>
                                <div id="bid-lp" class="absolute left-0 bottom-0 invisible flex items-center z-10">
                                    <div class="rounded px-3 py-1 flex items-center gap-2 shadow-lg min-w-[100px]"
                                        style="background: linear-gradient(to right, rgba(30, 58, 138, 0.3), rgba(30, 58, 138, 0.05));">
                                        <span class="text-lg font-bold text-white min-w-[50px]">JPM</span>
                                        <span class="text-lg text-amber-400 font-bold">0:08</span>
                                    </div>
                                </div>
                            </div>

                            <!-- OFFER SIDE -->
                            <div id="offer-tile" onclick="startRFQ()"
                                class="trade-tile flex-1 bg-tile-base hover-dark-mode rounded-r p-4 flex flex-col relative overflow-hidden group cursor-pointer border border-[#1e293b]">
                                <div class="success-indicator bg-blue-500/20 text-blue-400" id="offer-success">✓</div>
                                <div id="offer-label-container"
                                    class="flex justify-end items-start w-full absolute top-4 left-0 px-4 invisible">
                                    <span id="offer-label" class="text-xs font-bold text-red-500 tracking-widest">OFFER
                                        (VOL)</span>
                                </div>
                                <div class="flex-1 flex flex-col justify-center items-center">
                                    <span id="offer-rfq-label"
                                        class="text-[10px] text-slate-500 font-bold tracking-wider mb-1">CLICK TO RFQ
                                        (F9)</span>
                                    <div id="offer-value"
                                        class="text-slate-600 group-hover:text-white transition-colors duration-200 text-7xl font-bold tracking-tighter h-20 flex items-center">
                                        RFQ</div>
                                    <div id="offer-secondary"
                                        class="text-sm font-bold text-slate-700 mt-2 font-mono tracking-wide group-hover:text-slate-400 transition-colors invisible">
                                        ---</div>
                                </div>
                                <div id="offer-lp" class="absolute right-0 bottom-0 invisible flex items-center z-10">
                                    <div class="rounded px-3 py-1 flex items-center gap-2 shadow-lg min-w-[100px] justify-end"
                                        style="background: linear-gradient(to left, rgba(30, 58, 138, 0.3), rgba(30, 58, 138, 0.05));">
                                        <span class="text-lg text-slate-400">1:52</span>
                                        <span class="text-lg font-bold text-white min-w-[50px] text-right">DEUT</span>
                                    </div>
                                </div>
                            </div>

                            <!-- SPREAD INDICATOR - Centered Badge Overlay (initially hidden) -->
                            <div id="spread-indicator"
                                class="absolute left-1/2 bottom-1 transform -translate-x-1/2 z-20 pointer-events-none invisible bg-[#0b0d10] px-3 py-1 rounded border border-[#1e293b]">
                                <span class="text-lg font-bold text-white">0.6</span>
                            </div>

                            <!-- BID Tooltip (positioned relative to left tile) -->
                            <div id="bid-tooltip" class="trade-tooltip" style="left: 10px; transform: none;">
                                <div class="tooltip-section">
                                    <div class="tooltip-label">Client Receives</div>
                                    <div class="tooltip-value">Vol <span class="tooltip-highlight">5.47%</span> based on
                                        notional of <span class="tooltip-highlight">EUR 10,000,000</span></div>
                                    <div class="tooltip-value mt-1">Premium: <span class="tooltip-highlight">EUR
                                            68,778</span> | <span class="tooltip-highlight">43p</span> EUR Pips</div>
                                </div>
                                <div class="tooltip-divider"></div>
                                <div class="tooltip-section">
                                    <div class="tooltip-label">Trade Details</div>
                                    <div class="tooltip-value">Buy <span class="tooltip-highlight">EUR Call / USD
                                            Put</span>, Notional <span class="tooltip-highlight">EUR 10M</span></div>
                                    <div class="tooltip-value mt-1">Strike: <span
                                            class="tooltip-highlight">1.1751</span> (ATM) | Expiry: <span
                                            class="tooltip-highlight">14 Jan 26</span> (1M)</div>
                                    <div class="tooltip-value mt-1">ExpCut: <span class="tooltip-highlight">NYC</span> |
                                        Settlement: <span class="tooltip-highlight">PHYSICAL</span></div>
                                </div>
                                <div class="tooltip-divider"></div>
                                <div class="tooltip-section">
                                    <div class="tooltip-label">Risk & Hedge</div>
                                    <div class="tooltip-value">Delta: <span class="tooltip-highlight">50.24%</span> (EUR
                                        5,023,800) | Vega: <span class="tooltip-highlight">EUR 4,850 / 1%</span></div>
                                    <div class="tooltip-value mt-1">Spot Hedge: Sell <span class="tooltip-highlight">EUR
                                            5,023,800</span> @ <span class="tooltip-highlight">1.1746</span></div>
                                </div>
                                <div class="tooltip-divider"></div>
                                <div class="tooltip-section">
                                    <div class="tooltip-label">Liquidity Provider</div>
                                    <div class="tooltip-value"><span class="tooltip-highlight">JPM</span> | Quote valid
                                        for <span class="tooltip-highlight">0:08</span></div>
                                </div>
                            </div>

                            <!-- OFFER Tooltip (positioned relative to right tile) -->
                            <div id="offer-tooltip" class="trade-tooltip"
                                style="right: 10px; left: auto; transform: none;">
                                <div class="tooltip-section">
                                    <div class="tooltip-label">Client Pays</div>
                                    <div class="tooltip-value">Vol <span class="tooltip-highlight">5.82%</span> based on
                                        notional of <span class="tooltip-highlight">EUR 10,000,000</span></div>
                                    <div class="tooltip-value mt-1">Premium: <span class="tooltip-highlight">EUR
                                            71,699</span> | <span class="tooltip-highlight">44p</span> EUR Pips</div>
                                </div>
                                <div class="tooltip-divider"></div>
                                <div class="tooltip-section">
                                    <div class="tooltip-label">Trade Details</div>
                                    <div class="tooltip-value">Buy <span class="tooltip-highlight">EUR Call / USD
                                            Put</span>, Notional <span class="tooltip-highlight">EUR 10M</span></div>
                                    <div class="tooltip-value mt-1">Strike: <span
                                            class="tooltip-highlight">1.1751</span> (ATM) | Expiry: <span
                                            class="tooltip-highlight">14 Jan 26</span> (1M)</div>
                                    <div class="tooltip-value mt-1">ExpCut: <span class="tooltip-highlight">NYC</span> |
                                        Settlement: <span class="tooltip-highlight">PHYSICAL</span></div>
                                </div>
                                <div class="tooltip-divider"></div>
                                <div class="tooltip-section">
                                    <div class="tooltip-label">Risk & Hedge</div>
                                    <div class="tooltip-value">Delta: <span class="tooltip-highlight">50.24%</span> (EUR
                                        5,023,800) | Vega: <span class="tooltip-highlight">EUR 4,850 / 1%</span></div>
                                    <div class="tooltip-value mt-1">Spot Hedge: Sell <span class="tooltip-highlight">EUR
                                            5,023,800</span> @ <span class="tooltip-highlight">1.1746</span></div>
                                </div>
                                <div class="tooltip-divider"></div>
                                <div class="tooltip-section">
                                    <div class="tooltip-label">Liquidity Provider</div>
                                    <div class="tooltip-value"><span class="tooltip-highlight">DEUT</span> | Quote valid
                                        for <span class="tooltip-highlight">1:52</span></div>
                                </div>
                            </div>
                        </div>

                        <!-- COMBINED CONTROL BAR: Ladder toggle + Price Display -->
                        <div
                            class="bg-[#14161b] border border-[#1e293b] rounded px-3 py-1.5 flex items-center justify-between select-none">
                            <!-- Left: Ladder toggle -->
                            <div id="ladder-summary" onclick="toggleLadder()"
                                class="flex items-center gap-1 cursor-pointer hover:text-slate-300 transition">
                                <span id="ladder-arrow"
                                    class="text-slate-500 text-[10px] transition-transform duration-200">▼</span>
                                <span class="text-[10px] text-slate-500 font-bold uppercase">4 LPs</span>
                            </div>

                            <!-- Right: Price Display dropdown -->
                            <div class="relative group">
                                <div
                                    class="flex items-center gap-2 cursor-pointer px-3 py-2 -mx-2 -my-1 rounded hover:bg-[#1e293b] transition">
                                    <span class="text-[10px] text-slate-500">Price Display</span>
                                    <span id="price-display-bar"
                                        class="text-[10px] text-blue-400 font-bold uppercase min-w-[55px] text-right">VOL</span>
                                    <span class="text-slate-500 text-[8px]">▼</span>
                                </div>
                                <div
                                    class="hidden group-hover:block absolute top-full right-0 mt-1 bg-[#16181d] border border-[#1e293b] shadow-xl z-50 min-w-[100px]">
                                    <div id="bar-opt-vol" onclick="setPriceDisplay('vol')"
                                        class="px-3 py-1.5 hover:bg-[#1e293b] text-white text-xs bg-blue-500/10 border-l-2 border-blue-500 cursor-pointer">
                                        VOL</div>
                                    <div id="bar-opt-premium" onclick="setPriceDisplay('premium')"
                                        class="px-3 py-1.5 hover:bg-[#1e293b] text-slate-400 text-xs border-l-2 border-transparent cursor-pointer">
                                        Premium</div>
                                    <div id="bar-opt-eur-pips" onclick="setPriceDisplay('eur-pips')"
                                        class="px-3 py-1.5 hover:bg-[#1e293b] text-slate-400 text-xs border-l-2 border-transparent cursor-pointer">
                                        EUR Pips</div>
                                    <div id="bar-opt-usd-pips" onclick="setPriceDisplay('usd-pips')"
                                        class="px-3 py-1.5 hover:bg-[#1e293b] text-slate-400 text-xs border-l-2 border-transparent cursor-pointer">
                                        USD Pips</div>
                                </div>
                            </div>
                        </div>

                        <!-- LADDER - Collapsible (hidden by default) -->
                        <div id="ladder-container" style="display: none; max-height: 0; opacity: 0;"
                            class="bg-[#14161b] border border-[#1e293b] rounded flex flex-col overflow-hidden transition-all duration-300 mt-1">
                            <div
                                class="grid grid-cols-[1fr_60px_1fr] bg-[#1a1d23] border-b border-[#1e293b] items-center py-1.5">
                                <div class="text-center text-[10px] text-slate-600 font-bold uppercase tracking-wider">
                                    You
                                    Rec
                                </div>
                                <div
                                    class="text-center text-[10px] text-slate-600 font-bold uppercase tracking-wider border-l border-r border-[#1e293b] h-full flex items-center justify-center">
                                    Venue</div>
                                <div class="text-center text-[10px] text-slate-600 font-bold uppercase tracking-wider">
                                    You
                                    Pay
                                </div>
                            </div>

                            <div id="ladder-content" class="overflow-y-auto flex-1 transition-all duration-300">
                                <!-- Row 1 - DEUT: Fresh quote (full opacity) -->
                                <div
                                    class="ladder-row grid grid-cols-[1fr_60px_1fr] border-b border-[#1e293b]/50 items-stretch h-12 group">
                                    <div class="flex flex-col justify-center items-center opacity-60">
                                        <div
                                            class="text-white/80 font-medium text-sm group-hover:text-white transition-colors">
                                            5.42</div>
                                        <div
                                            class="text-slate-700 font-medium text-[10px] mt-0.5 group-hover:text-slate-500">
                                            69k | 39p</div>
                                    </div>
                                    <div
                                        class="flex flex-col items-center justify-center font-bold text-white text-xs border-l border-r border-[#1e293b] ladder-col-mid">
                                        <span>DEUT</span>
                                        <div class="lp-timer timer-fresh">2:00</div>
                                        <input type="checkbox" checked class="lp-checkbox cursor-pointer" data-lp="DEUT" onchange="toggleLP(this)">
                                    </div>
                                    <div class="flex flex-col justify-center items-center best-offer-cell">
                                        <div
                                            class="text-white font-bold text-sm group-hover:text-white transition-colors">
                                            5.82</div>
                                        <div
                                            class="text-slate-600 font-medium text-[10px] mt-0.5 group-hover:text-slate-400">
                                            71k | 44p</div>
                                    </div>
                                </div>
                                <!-- Row 2 - JPM: Slightly stale (80% opacity) -->
                                <div class="ladder-row grid grid-cols-[1fr_60px_1fr] border-b border-[#1e293b]/50 items-stretch h-12 group"
                                    style="opacity: 0.85">
                                    <div class="flex flex-col justify-center items-center best-bid-cell">
                                        <div
                                            class="text-white font-bold text-sm group-hover:text-white transition-colors">
                                            5.47</div>
                                        <div
                                            class="text-slate-600 font-medium text-[10px] mt-0.5 group-hover:text-slate-400">
                                            68k | 43p</div>
                                    </div>
                                    <div
                                        class="flex flex-col items-center justify-center font-bold text-white text-xs border-l border-r border-[#1e293b] ladder-col-mid">
                                        <span>JPM</span>
                                        <div class="lp-timer timer-warning">0:25</div>
                                        <input type="checkbox" checked class="lp-checkbox cursor-pointer" data-lp="JPM" onchange="toggleLP(this)">
                                    </div>
                                    <div class="flex flex-col justify-center items-center opacity-60">
                                        <div
                                            class="text-white/80 font-medium text-sm group-hover:text-white transition-colors">
                                            5.90</div>
                                        <div
                                            class="text-slate-700 font-medium text-[10px] mt-0.5 group-hover:text-slate-500">
                                            72k | 51p</div>
                                    </div>
                                </div>
