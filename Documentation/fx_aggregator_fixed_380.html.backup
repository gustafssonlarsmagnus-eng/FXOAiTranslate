            <!-- DEAL CARDS PANEL - Right side, 380px, starts collapsed -->
            <div id="deals-panel" class="deals-panel w-[380px] flex flex-col flex-shrink-0 collapsed">

                <!-- HEADER with Close Arrow -->
                <div class="flex items-center mb-2 px-2">
                    <div class="flex items-center gap-2">
                        <span onclick="toggleDealsPanel()"
                            class="text-slate-500 hover:text-white cursor-pointer text-xs">▶</span>
                        <h2 class="text-sm font-bold text-slate-400 tracking-wider uppercase">Confirmed Deals</h2>
                    </div>
                </div>

                <!-- SORTABLE COLUMN HEADERS -->
                <div
                    class="grid grid-cols-[55px_1fr_45px_40px_75px] gap-2 px-3 py-2 bg-[#1a1d23] rounded-t border-b border-[#1e293b] text-[10px] text-slate-500 font-bold uppercase tracking-wider">
                    <div class="flex items-center gap-1 cursor-pointer hover:text-blue-400">Time</div>
                    <div class="cursor-pointer hover:text-blue-400">Instrument</div>
                    <div class="cursor-pointer hover:text-blue-400">LP</div>
                    <div class="cursor-pointer hover:text-blue-400">Side</div>
                    <div></div>
                </div>

                <!-- DEAL CARDS CONTAINER -->
                <div id="deals-container"
                    class="bg-[#14161b] rounded-b border border-t-0 border-[#1e293b] overflow-y-auto flex-1">

                    <!-- Empty State -->
                    <div id="no-deals" class="flex flex-col items-center justify-center py-12 text-slate-600">
                        <span class="text-xs">No trades yet</span>
                        <span class="text-[10px] text-slate-700 mt-1">Execute a trade to see it here</span>
                    </div>

                    <!-- Deal cards will be inserted here by JavaScript -->

                </div>
            </div>
        </div>
    </div>

    <script>
        let rfqActive = false;

        // Trade Parser - Natural Language Processing
        function parseTradeInput() {
            const input = document.getElementById('trade-input').value.trim();
            const feedback = document.getElementById('parse-feedback');

            if (!input) {
                feedback.className = 'mt-1 text-xs h-4 text-slate-600';
                feedback.textContent = '';
                return;
            }

            try {
                const parsed = parseTradeString(input);

                if (parsed) {
                    // Update header with parsed trade
                    const headerText = `${parsed.currencyPair} | ${parsed.tenor} ${parsed.optionType}`;
                    document.querySelector('h1').innerHTML = `<span class="text-sm font-bold tracking-tight text-slate-500">${parsed.currencyPair} <span class="text-slate-700">|</span> ${parsed.tenor} ${parsed.optionType}</span>`;

                    // Show success feedback
                    feedback.className = 'mt-1 text-xs h-4 text-green-400';
                    feedback.textContent = `✓ Parsed: ${parsed.direction} ${parsed.notional}M ${parsed.currencyPair} ${parsed.tenor} ${parsed.optionType} @ ${parsed.strike}`;

                    // Auto-trigger RFQ
                    setTimeout(() => {
                        startRFQ();
                    }, 500);

                    // Clear input after short delay
                    setTimeout(() => {
                        document.getElementById('trade-input').value = '';
                        feedback.textContent = '';
                    }, 3000);
                } else {
                    feedback.className = 'mt-1 text-xs h-4 text-amber-400';
                    feedback.textContent = '⚠ Could not parse trade. Try: "buy 10M EURUSD 1M call 1.18"';
                }
            } catch (error) {
                feedback.className = 'mt-1 text-xs h-4 text-red-400';
                feedback.textContent = `✗ Error: ${error.message}`;
            }
        }

        function parseTradeString(input) {
            const inputLower = input.toLowerCase();

            // Extract currency pair (6 chars, e.g., EURUSD, EURNOK)
            const currencyPairs = ['eurusd', 'usdjpy', 'gbpusd', 'audusd', 'usdcad', 'usdchf',
                'nzdusd', 'eurgbp', 'eurjpy', 'gbpjpy', 'eurchf', 'audjpy',
                'euraud', 'eurnok', 'eursek', 'usdnok', 'usdsek', 'usdtry',
                'usdmxn', 'usdzar', 'eurcad', 'audnzd', 'noksek', 'eurtry'];

            let currencyPair = null;
            for (const pair of currencyPairs) {
                if (inputLower.includes(pair)) {
                    currencyPair = pair.toUpperCase();
                    break;
                }
            }

            if (!currencyPair) return null;

            // Extract direction (buy/sell)
            const direction = inputLower.includes('buy') ? 'BUY' : inputLower.includes('sell') ? 'SELL' : 'BUY';

            // Extract option type (call/put)
            const optionType = inputLower.includes('call') ? 'CALL' : inputLower.includes('put') ? 'PUT' : 'CALL';

            // Extract notional (e.g., 10M, 25M)
            const notionalMatch = input.match(/(\d+(?:\.\d+)?)\s*M(?:M)?/i);
            const notional = notionalMatch ? notionalMatch[1] : '10';

            // Extract tenor (e.g., 1M, 3M, 6M, 1Y) or expiry date
            let tenor = '1M';
            const tenorMatch = input.match(/(\d+)\s*([MDWY])/i);
            if (tenorMatch) {
                tenor = tenorMatch[1] + tenorMatch[2].toUpperCase();
            }

            // Extract strike (decimal number, typically 4-5 digits with decimals)
            const strikeMatch = input.match(/\b(\d+\.\d{2,4})\b/);
            const strike = strikeMatch ? strikeMatch[1] : '1.1750';

            return {
                currencyPair,
                direction,
                optionType,
                notional,
                tenor,
                strike
            };
        }

        // ============================================================================
        // LP TIMER MANAGEMENT SYSTEM
        // ============================================================================

        const lpTimers = new Map();
        const QUOTE_VALIDITY_SECONDS = 120;
        const TIMER_UPDATE_INTERVAL = 100;
        const TIMER_FRESH = 90,
            TIMER_AGING = 30,
            TIMER_URGENT = 10;

        function startLPTimer(lp, validitySeconds = QUOTE_VALIDITY_SECONDS, quoteId = null) {
            stopLPTimer(lp);
            const expiryTime = Date.now() + (validitySeconds * 1000);
            const intervalId = setInterval(() => updateLPTimer(lp), TIMER_UPDATE_INTERVAL);
            lpTimers.set(lp, { intervalId, expiryTime, quoteId });
            updateLPTimer(lp);
        }

        function stopLPTimer(lp) {
            const timer = lpTimers.get(lp);
            if (timer) {
                clearInterval(timer.intervalId);
                lpTimers.delete(lp);
            }
        }

        function updateLPTimer(lp) {
            const timer = lpTimers.get(lp);
            if (!timer) return;

            const remainingSeconds = Math.max(0, Math.floor((timer.expiryTime - Date.now()) / 1000));
            const checkbox = document.querySelector(`.lp-checkbox[data-lp="${lp}"]`);
            if (!checkbox) return;

            const lpRow = checkbox.closest('.ladder-row');
            const midCell = lpRow?.querySelector(':scope > div:nth-child(2)');
            if (!midCell) return;

            let timerElement = midCell.querySelector('.lp-timer');
            if (!timerElement) {
                timerElement = document.createElement('div');
                timerElement.className = 'lp-timer';
                midCell.appendChild(timerElement);
            }

            const minutes = Math.floor(remainingSeconds / 60);
            const seconds = remainingSeconds % 60;
            timerElement.textContent = `${minutes}:${seconds.toString().padStart(2, '0')}`;

            timerElement.classList.remove('timer-fresh', 'timer-warning', 'timer-urgent', 'timer-expired');
            lpRow.classList.remove('quote-fresh', 'quote-aging', 'quote-stale', 'quote-expired');

            // Track previous state for logging
            const prevState = lpRow.dataset.timerState || 'unknown';
            let newState;

            if (remainingSeconds <= 0) {
                timerElement.classList.add('timer-expired');
                lpRow.classList.add('quote-expired');
                timerElement.textContent = 'EXPIRED';
                newState = 'expired';
                stopLPTimer(lp);
            } else if (remainingSeconds <= TIMER_URGENT) {
                timerElement.classList.add('timer-urgent');
                lpRow.classList.add('quote-stale');
                newState = 'urgent';
            } else if (remainingSeconds <= TIMER_AGING) {
                timerElement.classList.add('timer-warning');
                lpRow.classList.add('quote-aging');
                newState = 'aging';
            } else if (remainingSeconds >= TIMER_FRESH) {
                timerElement.classList.add('timer-fresh');
                lpRow.classList.add('quote-fresh');
                newState = 'fresh';
            } else {
                timerElement.classList.add('timer-warning');
                lpRow.classList.add('quote-aging');
                newState = 'aging';
            }

            // Log state transitions
            if (prevState !== newState) {
                console.log(`[Timer] ${lp} state: ${prevState} → ${newState} (${remainingSeconds}s remaining)`);
                lpRow.dataset.timerState = newState;
            }

            if (!checkbox.checked) {
                const priceColumns = lpRow.querySelectorAll(':scope > div:not(:nth-child(2))');
                priceColumns.forEach(col => col.style.opacity = '0.2');
            }
        }

        function stopAllLPTimers() {
            lpTimers.forEach((timer, lp) => clearInterval(timer.intervalId));
            lpTimers.clear();
        }

        window.addEventListener('beforeunload', stopAllLPTimers);

        // Initialize demo timers for static ladder (for testing/demo)
        function initializeDemoTimers() {
            // Start timers with different states for demo
            startLPTimer('DEUT', 120);  // 2:00 - Fresh
            startLPTimer('JPM', 25);    // 0:25 - Aging
            startLPTimer('CITI', 8);    // 0:08 - Urgent
            startLPTimer('BARX', 0);    // EXPIRED
            console.log('[Timer] Demo timers initialized');
        }

        // ============================================================================
        // WEBVIEW2 BRIDGE: Real-time GFI quote integration
        // ============================================================================

        // Check if we're running in WebView2 environment
        const isWebView2 = window.chrome && window.chrome.webview;

        if (isWebView2) {
            console.log('[FX Aggregator] Running in WebView2 - GFI integration enabled');

            // Listen for quotes from C# via WebView2 bridge
            // Expected quote message format:
            // {
            //   type: 'quote',
            //   lp: 'JPM',
            //   side: 'BID' | 'OFFER',
            //   bidPremium: 5.47,
            //   offerPremium: 5.82,
            //   bidVol: 5.47,
            //   offerVol: 5.82,
            //   notional: 10000000,
            //   delta: 50.24,
            //   timestamp: '2025-12-17T12:00:00Z',
            //   quoteId: 'Q12345',
            //   validitySeconds: 120  // Optional: defaults to 120s if not provided
            // }
            window.chrome.webview.addEventListener('message', event => {
                try {
                    const data = JSON.parse(event.data);

                    if (data.type === 'quote') {
                        updateLPQuote(data);  // Automatically starts/restarts timer with validitySeconds
                    } else if (data.type === 'tradeDetails') {
                        initializeTradeDetails(data);
                    }
                } catch (error) {
                    console.error('[FX Aggregator] Error processing message:', error);
                }
            });

            // Notify C# that JavaScript is ready
            window.chrome.webview.postMessage(JSON.stringify({ type: 'ready' }));
        } else {
            console.log('[FX Aggregator] Running in browser - using mock data');
        }

        // Initialize UI with trade details from TradeStructure
        function initializeTradeDetails(trade) {
            console.log(`[FX Aggregator] Initializing trade details: ${trade.underlying} ${trade.legs.length} leg(s)`);

            // Update title with underlying
            document.title = `FX Aggregator - ${trade.underlying}`;

            // Determine structure type name
            const structureTypes = {
                '1': 'Vanilla Option',
                '5': 'Risk Reversal',
                '8': 'Call Spread',
                '9': 'Put Spread',
                '10': 'Seagull'
            };
            const structureName = structureTypes[trade.structureType] || 'Multi-Leg Option';

            // For single-leg trades, populate Option 1 details
            if (trade.legs.length >= 1) {
                const leg = trade.legs[0];
                const baseCcy = trade.underlying.substring(0, 3); // EUR from EURNOK

                // Update Option 1 fields (you'll need to add IDs to the HTML elements)
                // For now, just log the data
                console.log(`[FX Aggregator] Leg 1: ${leg.direction} ${leg.notionalMM}M ${baseCcy} ${leg.strike} ${leg.optionType}`);
            }

            // Store trade data globally for execution
            window.tradeData = trade;
        }

        // Update LP ladder with live quote from GFI
        function updateLPQuote(quote) {
            console.log(`[FX Aggregator] Received quote: ${quote.lp} ${quote.side} BID:${quote.bidPremium} OFFER:${quote.offerPremium} Vol:${quote.bidVol}/${quote.offerVol} Notional:${quote.notional} Delta:${quote.delta}`);

            // Find the LP row by data-lp attribute
            const checkbox = document.querySelector(`.lp-checkbox[data-lp="${quote.lp}"]`);
            if (!checkbox) {
                console.warn(`[FX Aggregator] LP not found: ${quote.lp}`);
                return;
            }

            const lpRow = checkbox.closest('.ladder-row');
            if (!lpRow) return;

            // Get all cells in the row
            const cells = lpRow.querySelectorAll(':scope > div');
            const bidCell = cells[0];    // First column (BID)
            const midCell = cells[1];    // Middle column (LP name + spread)
            const offerCell = cells[2];  // Third column (OFFER)

            // Update BID side
            if (quote.side === "BID") {
                const bidPrice = bidCell.querySelector('div:first-child');
                const bidDetails = bidCell.querySelector('div:nth-child(2)');

                if (bidPrice) {
                    bidPrice.textContent = formatPremium(quote.bidPremium);
                    flashPrice(bidPrice);
                }

                if (bidDetails && quote.notional && quote.delta) {
                    const notionalK = (quote.notional / 1000).toFixed(0) + 'k';
                    const deltaP = Math.round(quote.delta) + 'p';
                    bidDetails.textContent = `${notionalK} | ${deltaP}`;
                }
            }

            // Update OFFER side
            if (quote.side === "OFFER") {
                const offerPrice = offerCell.querySelector('div:first-child');
                const offerDetails = offerCell.querySelector('div:nth-child(2)');

                if (offerPrice) {
                    offerPrice.textContent = formatPremium(quote.offerPremium);
                    flashPrice(offerPrice);
                }

                if (offerDetails && quote.notional && quote.delta) {
                    const notionalK = (quote.notional / 1000).toFixed(0) + 'k';
                    const deltaP = Math.round(quote.delta) + 'p';
                    offerDetails.textContent = `${notionalK} | ${deltaP}`;
                }
            }

            // Store quote data on the row for spread calculation
            if (quote.side === "BID") {
                lpRow.dataset.bidPremium = quote.bidPremium;
                lpRow.dataset.bidVol = quote.bidVol;
            } else {
                lpRow.dataset.offerPremium = quote.offerPremium;
                lpRow.dataset.offerVol = quote.offerVol;
            }

            // Calculate and display spread if we have both sides
            if (lpRow.dataset.bidPremium && lpRow.dataset.offerPremium) {
                const spread = Math.abs(parseFloat(lpRow.dataset.offerPremium) - parseFloat(lpRow.dataset.bidPremium));
                const spreadElement = midCell.querySelector('span:nth-child(2)');
                if (spreadElement) {
                    spreadElement.textContent = spread.toFixed(2);
                }
            }

            // Update metadata
            lpRow.dataset.quoteTime = quote.timestamp;
            lpRow.dataset.quoteId = quote.quoteId;

            // Start or restart countdown timer
            const validitySeconds = quote.validitySeconds || QUOTE_VALIDITY_SECONDS;
            startLPTimer(quote.lp, validitySeconds, quote.quoteId);

            // Recalculate best BID/OFFER and update hero tiles
            updateHeroTiles();
        }

        // Format premium value for display
        function formatPremium(value) {
            // Display absolute value with 2 decimals
            return Math.abs(value).toFixed(2);
        }

        // Flash animation on price update
        function flashPrice(element) {
            element.classList.add('price-flash');
            setTimeout(() => element.classList.remove('price-flash'), 500);
        }

        // Calculate best BID/OFFER across all enabled LPs
        function updateHeroTiles() {
            let bestBid = null;
            let bestOffer = null;
            let bestBidLP = null;
            let bestOfferLP = null;
            let bestBidVol = null;
            let bestOfferVol = null;

            // Iterate through checked (enabled) LPs only
            document.querySelectorAll('.lp-checkbox:checked').forEach(checkbox => {
                const row = checkbox.closest('.ladder-row');
                const cells = row.querySelectorAll(':scope > div');

                const bidPrice = parseFloat(cells[0].querySelector('div:first-child').textContent);
                const offerPrice = parseFloat(cells[2].querySelector('div:first-child').textContent);
                const lp = checkbox.dataset.lp;

                // Get volatility values from row dataset
                const bidVol = row.dataset.bidVol ? parseFloat(row.dataset.bidVol) : null;
                const offerVol = row.dataset.offerVol ? parseFloat(row.dataset.offerVol) : null;

                // Best BID = highest (you receive more)
                if (!isNaN(bidPrice) && (bestBid === null || bidPrice > bestBid)) {
                    bestBid = bidPrice;
                    bestBidLP = lp;
                    bestBidVol = bidVol;
                }

                // Best OFFER = lowest (you pay less)
                if (!isNaN(offerPrice) && (bestOffer === null || offerPrice < bestOffer)) {
                    bestOffer = offerPrice;
                    bestOfferLP = lp;
                    bestOfferVol = offerVol;
                }
            });

            // Update hero tiles with best prices
            const bidTile = document.getElementById('bid-tile');
            const offerTile = document.getElementById('offer-tile');

            if (bestBid !== null && bidTile) {
                const bidValueElement = bidTile.querySelector('#bid-value');
                if (bidValueElement) {
                    bidValueElement.textContent = bestBid.toFixed(2);
                    bidValueElement.classList.remove('text-slate-600');
                    bidValueElement.classList.add('text-white');
                }

                // Update LP indicator
                const bidLPElement = bidTile.querySelector('.text-xs.text-slate-500');
                if (bidLPElement) {
                    bidLPElement.textContent = bestBidLP || '—';
                }

                // Update volatility in secondary display
                const bidSecondary = document.getElementById('bid-secondary');
                if (bidSecondary && bestBidVol !== null) {
                    bidSecondary.textContent = `${bestBidVol.toFixed(2)}%`;
                    bidSecondary.classList.remove('invisible');
                }

                // Show BID label
                const bidLabelContainer = document.getElementById('bid-label-container');
                const bidRfqLabel = document.getElementById('bid-rfq-label');
                if (bidLabelContainer) bidLabelContainer.classList.remove('invisible');
                if (bidRfqLabel) bidRfqLabel.classList.add('invisible');
            }

            if (bestOffer !== null && offerTile) {
                const offerValueElement = offerTile.querySelector('#offer-value');
                if (offerValueElement) {
                    offerValueElement.textContent = bestOffer.toFixed(2);
                    offerValueElement.classList.remove('text-slate-600');
                    offerValueElement.classList.add('text-white');
                }

                // Update LP indicator
                const offerLPElement = offerTile.querySelector('.text-xs.text-slate-500');
                if (offerLPElement) {
                    offerLPElement.textContent = bestOfferLP || '—';
                }

                // Update volatility in secondary display
                const offerSecondary = document.getElementById('offer-secondary');
                if (offerSecondary && bestOfferVol !== null) {
                    offerSecondary.textContent = `${bestOfferVol.toFixed(2)}%`;
                    offerSecondary.classList.remove('invisible');
                }

                // Show OFFER label
                const offerLabelContainer = document.getElementById('offer-label-container');
                const offerRfqLabel = document.getElementById('offer-rfq-label');
                if (offerLabelContainer) offerLabelContainer.classList.remove('invisible');
                if (offerRfqLabel) offerRfqLabel.classList.add('invisible');
            }

            console.log(`[FX Aggregator] Best prices updated - BID: ${bestBid} (${bestBidLP}) ${bestBidVol}%, OFFER: ${bestOffer} (${bestOfferLP}) ${bestOfferVol}%`);
        }

        // Send execution request to C# when user clicks BID/OFFER tiles
        function executeTrade(event, side) {
            const tile = document.getElementById(side + '-tile');

            // Flash Effect
            tile.classList.remove('trade-flash-' + side);
            void tile.offsetWidth; // Force reflow
            tile.classList.add('trade-flash-' + side);

            setTimeout(() => {
                tile.classList.remove('trade-flash-' + side);
            }, 750);

            // Get the best quote for this side
            const quoteId = getBestQuoteId(side);

            if (quoteId && isWebView2) {
                // Send execution request to C#
                const message = {
                    type: 'execute',
                    side: side.toUpperCase(),
                    quoteId: quoteId
                };

                window.chrome.webview.postMessage(JSON.stringify(message));
                console.log(`[FX Aggregator] Execution requested: ${side} on QuoteID ${quoteId}`);
            }

            // Create deal card
            createDealCard(side);
        }

        // Get the QuoteID for the best BID or OFFER
        function getBestQuoteId(side) {
            let bestPrice = null;
            let bestQuoteId = null;

            document.querySelectorAll('.lp-checkbox:checked').forEach(checkbox => {
                const row = checkbox.closest('.ladder-row');
                const cells = row.querySelectorAll(':scope > div');

                const cell = side === 'bid' ? cells[0] : cells[2];
                const priceElement = cell.querySelector('div:first-child');

                if (priceElement) {
                    const price = parseFloat(priceElement.textContent);
                    const quoteId = row.dataset.quoteId;

                    if (!isNaN(price) && quoteId) {
                        if (bestPrice === null ||
                            (side === 'bid' && price > bestPrice) ||
                            (side === 'offer' && price < bestPrice)) {
                            bestPrice = price;
                            bestQuoteId = quoteId;
                        }
                    }
                }
            });

            return bestQuoteId;
        }

        // CSS for price flash animation
        const style = document.createElement('style');
        style.textContent = `
            .price-flash {
                animation: priceFlash 0.5s ease-out;
            }

            @keyframes priceFlash {
                0% {
                    background-color: #3b82f6;
                    color: white;
                    transform: scale(1.1);
                }
                100% {
                    background-color: transparent;
                    color: inherit;
                    transform: scale(1);
                }
            }
        `;
        document.head.appendChild(style);

        // Initialize demo timers when not in WebView2 mode
        if (!isWebView2) {
            // Delay to ensure DOM is fully loaded
            setTimeout(() => {
                initializeDemoTimers();
            }, 100);
        }

    </script>
</body>

</html>