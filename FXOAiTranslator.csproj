<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="GFI_STP_Monitor\**" />
    <EmbeddedResource Remove="GFI_STP_Monitor\**" />
    <None Remove="GFI_STP_Monitor\**" />
    <!-- Exclude WPF project files from being processed by this project -->
    <Compile Remove="FXOAiTranslate.WPF\**" />
    <Page Remove="FXOAiTranslate.WPF\**" />
    <ApplicationDefinition Remove="FXOAiTranslate.WPF\**" />
    <None Remove="FXOAiTranslate.WPF\**" />
    <EmbeddedResource Remove="FXOAiTranslate.WPF\**" />
    <!-- Exclude FXOptionsSimulator project files from being processed by this project -->
    <Compile Remove="FXOptionsSimulator\**" />
    <Page Remove="FXOptionsSimulator\**" />
    <None Remove="FXOptionsSimulator\**" />
    <EmbeddedResource Remove="FXOptionsSimulator\**" />
    <!-- Exclude Tests project files from being processed by this project -->
    <Compile Remove="FXOAiTranslate.Tests\**" />
    <Page Remove="FXOAiTranslate.Tests\**" />
    <None Remove="FXOAiTranslate.Tests\**" />
    <EmbeddedResource Remove="FXOAiTranslate.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QLNet" Version="1.13.1" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="9.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="FXOptionsSimulator\FXOptionsSimulator.csproj" />
    <ProjectReference Include="FXOAiTranslate.WPF\FXOAiTranslate.WPF.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Bloomberglp.Blpapi">
      <HintPath>C:\Program Files (x86)\STP\Bloomberglp.Blpapi.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="quickfix.cfg">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>