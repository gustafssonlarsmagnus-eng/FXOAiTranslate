<UserControl x:Class="FXOAiTranslate.WPF.Controls.LegPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FXOAiTranslate.WPF.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="400">

    <UserControl.Resources>
        <ResourceDictionary Source="/FXOAiTranslate.WPF;component/Styles/Styles.xaml"/>
    </UserControl.Resources>

    <Border Background="{StaticResource BrushBackgroundMain}" 
            BorderBrush="{StaticResource BrushBorder}"
            BorderThickness="0,0,1,0">
        
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10">
                
                <!-- 1. HEADER / NLP INPUT -->
                <TextBlock Text="Initial Request (AI Parsed)" 
                           Foreground="{StaticResource BrushTextMuted}" 
                           FontSize="10" 
                           Margin="0,0,0,2"/>
                
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBox x:Name="TxtInput"
                             Grid.Column="0"
                             Text="{Binding RawInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Height="30"
                             VerticalContentAlignment="Center"
                             FontSize="12"
                             Tag="Type trade (e.g. 'buy 10m eurusd 1m call 1.12')"/>
                    
                    <Button Grid.Column="1"
                            Content="PARSE"
                            Margin="5,0,0,0"
                            Width="50"
                            Style="{StaticResource ExecutionButtonStyle}"
                            Background="{StaticResource BrushBackgroundHeader}"
                            Foreground="{StaticResource BrushTextPrimary}"
                            FontSize="10"
                            FontWeight="Bold"
                            Command="{Binding ParseCommand}"/> 
                </Grid>

                <!-- 2. EXECUTION TILES (Prominent) -->
                <Grid Height="110" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- BID TILE -->
                    <local:ExecutionTile Grid.Column="0"
                                         SideLabel="YOU REC"
                                         SideLabelBrush="{StaticResource BrushAccentGreen}"
                                         Price="{Binding BestBidPrice}"
                                         IsRfqState="{Binding IsRfqState}"
                                         FooterText="{Binding BestBidLP}"
                                         Command="{Binding ExecuteBidCommand}"/>

                    <!-- ASK TILE -->
                    <local:ExecutionTile Grid.Column="2" 
                                         SideLabel="YOU PAY"
                                         SideLabelBrush="{StaticResource BrushAccentRed}"
                                         Price="{Binding BestAskPrice}"
                                         IsRfqState="{Binding IsRfqState}"
                                         FooterText="{Binding BestAskLP}"
                                         PriceBrush="{StaticResource BrushTextBuy}" 
                                         Command="{Binding ExecuteAskCommand}"/>
                </Grid>

                <!-- 3. PRICE DISPLAY TOGGLE -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Display:" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" FontSize="11"/>
                    <ComboBox Grid.Column="1" Margin="10,0,0,0" Height="22" SelectedIndex="0"
                              Style="{StaticResource {x:Type ComboBox}}"
                              SelectedValuePath="Tag"
                              SelectedValue="{Binding PriceDisplayMode}"> <!-- 1=Vol, 2=Prem, 3=Pips -->
                        <ComboBoxItem Content="Volatility (Purple)" Tag="1"/>
                        <ComboBoxItem Content="Premium (Green)" Tag="2"/>
                        <ComboBoxItem Content="Pips (Green)" Tag="3"/>
                    </ComboBox>
                </Grid>

                <!-- 4. LADDER VIEW (Prominent, High Visibility) -->
                <Expander x:Name="ExpanderLadder" 
                          Header="Liquidity Ladder" 
                          IsExpanded="True"
                          Style="{StaticResource BarExpanderStyle}"
                          Margin="0,0,0,5">
                    <local:LadderView Height="200"/>
                </Expander>

                <!-- 5. OPTION DETAILS EXPANDER (Collapsed by default) -->
                <Expander IsExpanded="False" 
                          Header="Option 1"
                          Margin="0,0,0,5"
                          Style="{StaticResource BarExpanderStyle}">
                    <Border Background="{StaticResource BrushBackgroundPanel}" Padding="10">
                        <StackPanel>
                        
                        <!-- Manual Entry Fields (using LegDetailRow lookalikes but editable) -->
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Strike" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" FontSize="11"/>
                            <TextBox Grid.Column="1" Text="{Binding Strike}" Style="{StaticResource SlimTextBoxStyle}"/>
                        </Grid>

                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Term" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" FontSize="11"/>
                            <TextBox Grid.Column="1" Text="{Binding Tenor}" Style="{StaticResource SlimTextBoxStyle}"/>
                        </Grid>

                         <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Expiry" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" FontSize="11"/>
                            <TextBox Grid.Column="1" Text="{Binding ExpiryDateString}" Style="{StaticResource SlimTextBoxStyle}" IsReadOnly="True" Background="{StaticResource BrushBackgroundMain}" Foreground="{StaticResource BrushTextMuted}"/>
                        </Grid>

                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Type" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" FontSize="11"/>
                            <ComboBox Grid.Column="1" SelectedItem="{Binding OptionType}" Height="22" FontSize="11" Padding="4,2">
                                <ComboBoxItem Content="CALL"/>
                                <ComboBoxItem Content="PUT"/>
                            </ComboBox>
                        </Grid>
                        
                         <!-- Hedge / Spot Ref Section -->
                        <Grid Margin="0,8,0,2"> <!-- Extra margin for separate section -->
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Hedge" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" FontSize="11"/>
                            <ComboBox Grid.Column="1" SelectedItem="{Binding HedgeType}" Height="22" FontSize="11" Padding="4,2">
                                <ComboBoxItem Content="None"/>
                                <ComboBoxItem Content="Spot"/>
                                <ComboBoxItem Content="Forward"/>
                            </ComboBox>
                        </Grid>

                         <!-- Spot Ref Input (Visible only if Hedge != None) -->
                        <Grid Margin="0,2" Visibility="{Binding IsHedgeEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Spot Ref" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" FontSize="11"/>
                            <TextBox Grid.Column="1" Text="{Binding SpotRefInput}" Style="{StaticResource SlimTextBoxStyle}" Tag="SP..."/>
                        </Grid>
                        
                        </StackPanel>
                    </Border>
                </Expander>

                <!-- 6. MARKET DATA EXPANDER (Collapsed) -->
                <Expander Header="Market Data" IsExpanded="False" Margin="0,0,0,5" Style="{StaticResource BarExpanderStyle}">
                    <Border Background="{StaticResource BrushBackgroundPanel}" Padding="5">
                         <Grid>
                             <Grid.RowDefinitions>
                                 <RowDefinition Height="Auto"/>
                                 <RowDefinition Height="Auto"/>
                             </Grid.RowDefinitions>
                             <local:LegDetailRow Label="Spot Rate" Value="{Binding MarketSpot}" Grid.Row="0" Margin="0,0,0,2"/>
                             <local:LegDetailRow Label="Fwd Pts" Value="{Binding MarketFwdPts}" Grid.Row="1"/>
                         </Grid>
                    </Border>
                </Expander>
                
                <!-- 7. RISK EXPANDER (Collapsed) -->
                 <Expander Header="Risk" IsExpanded="False" Margin="0,0,0,5" Style="{StaticResource BarExpanderStyle}">
                    <Border Background="{StaticResource BrushBackgroundPanel}" Padding="5">
                         <Grid>
                             <Grid.RowDefinitions>
                                 <RowDefinition Height="Auto"/>
                                 <RowDefinition Height="Auto"/>
                             </Grid.RowDefinitions>
                             <local:LegDetailRow Label="Delta" Value="{Binding RiskDelta}" Grid.Row="0" Margin="0,0,0,2"/>
                             <local:LegDetailRow Label="Vol" Value="{Binding RiskVol}" Grid.Row="1"/>
                         </Grid>
                    </Border>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
