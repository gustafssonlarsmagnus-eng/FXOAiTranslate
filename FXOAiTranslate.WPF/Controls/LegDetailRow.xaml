<UserControl x:Class="FXOAiTranslate.WPF.Controls.LegDetailRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="30" d:DesignWidth="300">

    <UserControl.Resources>
        <ResourceDictionary Source="/FXOAiTranslate.WPF;component/Styles/Styles.xaml"/>
    </UserControl.Resources>

    <Grid Margin="0,1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Label Column -->
        <Border Grid.Column="0" 
                Background="{StaticResource BrushBackgroundHeader}" 
                BorderBrush="{StaticResource BrushBorder}" 
                BorderThickness="1,1,0,1"
                Padding="5,4">
            <TextBlock Text="{Binding Label, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Foreground="{StaticResource BrushTextSecondary}"
                       FontWeight="SemiBold"
                       FontSize="11"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"/>
        </Border>

        <!-- Value Column -->
        <Border Grid.Column="1" 
                Background="{StaticResource BrushBackgroundInput}" 
                BorderBrush="{StaticResource BrushBorder}" 
                BorderThickness="1"
                Padding="8,4">
            <TextBlock Text="{Binding Value, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Foreground="{StaticResource BrushTextPrimary}"
                       FontSize="12"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"/>
        </Border>
    </Grid>
</UserControl>
