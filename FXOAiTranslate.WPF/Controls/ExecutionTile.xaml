<UserControl x:Class="FXOAiTranslate.WPF.Controls.ExecutionTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="192" d:DesignWidth="200">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FXOAiTranslate.WPF;component/Styles/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- HTML: h-48 = 192px, bg-tile-base gradient -->
    <Border x:Name="MainBorder"
            Background="{StaticResource BrushTileBackground}"
            BorderBrush="{StaticResource BrushBorder}"
            BorderThickness="1"
            CornerRadius="4"
            Height="192"
            Cursor="Hand"
            MouseLeftButtonUp="Border_MouseLeftButtonUp">
        
        <Grid Margin="16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Header: YOU REC/YOU PAY -->
                <RowDefinition Height="*"/>     <!-- Price Display (centered) -->
                <RowDefinition Height="Auto"/>  <!-- Sub-info: Premium | Pips -->
                <RowDefinition Height="Auto"/>  <!-- Footer: LP + Timer -->
            </Grid.RowDefinitions>

            <!-- Header: YOU REC / YOU PAY (text-xs = 12px) -->
            <TextBlock x:Name="HeaderLabel"
                       Grid.Row="0"
                       Text="{Binding SideLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       HorizontalAlignment="Left"
                       FontSize="12"
                       FontWeight="Bold"
                       Foreground="{Binding SideLabelBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

            <!-- Price Display (centered) -->
            <StackPanel Grid.Row="1" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center">
                
                <!-- RFQ State: text-7xl = 72px -->
                <TextBlock Text="RFQ"
                           FontSize="72"
                           FontWeight="Bold"
                           Foreground="{StaticResource BrushTextMuted}"
                           Visibility="{Binding IsRfqState, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- Live Price State: text-7xl = 72px bold white -->
                <TextBlock x:Name="PriceText"
                           Text="{Binding DisplayPrice, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontSize="72"
                           FontWeight="Bold"
                           Foreground="{StaticResource BrushTextPrimary}"
                           Visibility="{Binding IsRfqState, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
            </StackPanel>

            <!-- Sub-info: Premium | Pips (text-sm = 14px) -->
            <TextBlock Grid.Row="2"
                       Text="{Binding SubInfo, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       HorizontalAlignment="Center"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource BrushTextMuted}"
                       Margin="0,4,0,0"
                       Visibility="{Binding IsRfqState, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

            <!-- Footer: LP Name + Timer (text-lg = 18px) -->
            <Grid Grid.Row="3" Margin="0,8,0,0"
                  Visibility="{Binding IsRfqState, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- LP Name -->
                <TextBlock Grid.Column="0"
                           Text="{Binding LPName, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{StaticResource BrushTextPrimary}"
                           HorizontalAlignment="{Binding LPAlignment, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                
                <!-- Timer -->
                <TextBlock Grid.Column="1"
                           Text="{Binding TimerText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{StaticResource BrushAccentAmber}"
                           HorizontalAlignment="{Binding TimerAlignment, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            </Grid>
            
            <!-- Hover overlay effect (transparent, for visual feedback) -->
            <Rectangle Grid.RowSpan="4" 
                       Fill="Transparent" 
                       IsHitTestVisible="False"
                       x:Name="FlashOverlay"/>
        </Grid>
    </Border>
</UserControl>
