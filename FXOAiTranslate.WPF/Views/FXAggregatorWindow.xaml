<Window x:Class="FXOAiTranslate.WPF.Views.FXAggregatorWindow"
     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="FX Aggregator" 
     Height="850" Width="1100"
  WindowStartupLocation="CenterScreen"
        Background="#0b0d10"
        FontFamily="Inter, Segoe UI">

 <Window.Resources>
        <ResourceDictionary>
     <ResourceDictionary.MergedDictionaries>
           <ResourceDictionary Source="/FXOAiTranslate.WPF;component/Styles/Colors.xaml"/>
                <ResourceDictionary Source="/FXOAiTranslate.WPF;component/Styles/ButtonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    
            <!-- Dark ComboBox Style -->
            <Style x:Key="DarkComboBox" TargetType="ComboBox">
          <Setter Property="Background" Value="#0f1114"/>
     <Setter Property="Foreground" Value="#e2e8f0"/>
    <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="11"/>
      <Setter Property="Padding" Value="4,2"/>
    </Style>
         
       <!-- Dark TextBox Style -->
<Style x:Key="DarkTextBox" TargetType="TextBox">
      <Setter Property="Background" Value="#0f1114"/>
       <Setter Property="Foreground" Value="#e2e8f0"/>
      <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontSize" Value="11"/>
     <Setter Property="Padding" Value="4,2"/>
        <Setter Property="CaretBrush" Value="#e2e8f0"/>
            </Style>
  
         <!-- LP Checkbox Style -->
      <Style x:Key="LPCheckBox" TargetType="CheckBox">
   <Setter Property="Foreground" Value="#e2e8f0"/>
                <Setter Property="FontSize" Value="11"/>
   <Setter Property="FontWeight" Value="Bold"/>
 <Setter Property="Margin" Value="0,0,16,0"/>
  <Setter Property="Cursor" Value="Hand"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <!-- Main Content -->
        <Grid Margin="8">
  <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
  <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

            <!-- LEFT: Quote Panel + Leg Details -->
 <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Column="0">
          <StackPanel>
               
        <!-- TRADE INPUT -->
     <Border Background="#0f1114" BorderBrush="#1e293b" BorderThickness="1" CornerRadius="4" Margin="0,0,0,8">
           <Grid>
    <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
           <TextBox x:Name="txtTradeInput" 
     Style="{StaticResource DarkTextBox}"
  FontSize="13" Padding="12,10"
        Text="BUY 10M EURUSD 1M CALL 1.1751"/>
        <Button Grid.Column="1" Content="Parse" 
     Padding="16,10" Margin="0"
  Background="#1e3a5f" Foreground="#3b82f6"
            BorderThickness="0" Cursor="Hand" FontWeight="Bold"
           Click="ParseButton_Click"/>
    </Grid>
         </Border>

   <!-- EXECUTION TILES -->
    <Grid Height="200" Margin="0,0,0,8">
   <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
         <ColumnDefinition Width="2"/>
           <ColumnDefinition Width="*"/>
       </Grid.ColumnDefinitions>

            <!-- BID TILE -->
            <Border x:Name="bidTile" Grid.Column="0" 
         Background="{StaticResource Brush.TileGradient}"
      BorderBrush="#1e293b" BorderThickness="1"
       CornerRadius="4,0,0,4" Cursor="Hand"
            MouseLeftButtonUp="BidTile_Click">
       <Grid Margin="16">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
           <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
       <TextBlock x:Name="lblBidLabel" Text="CLICK TO RFQ" 
          FontSize="10" FontWeight="Bold" Foreground="#64748b"/>
    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
     <TextBlock x:Name="lblBidValue" Text="RFQ" 
    FontSize="48" FontWeight="Bold" Foreground="#64748b"
            HorizontalAlignment="Center"/>
       <TextBlock x:Name="lblBidSecondary" Text="" 
  FontSize="11" Foreground="#64748b"
         HorizontalAlignment="Center" Margin="0,4,0,0"
                  Visibility="Collapsed"/>
           </StackPanel>
     <Border Grid.Row="2" HorizontalAlignment="Left" Padding="8,4" CornerRadius="4"
          Background="#1e3a5f" x:Name="bidLPPanel" Visibility="Collapsed">
  <StackPanel Orientation="Horizontal">
    <TextBlock x:Name="lblBidLP" Text="" FontSize="14" FontWeight="Bold" Foreground="White"/>
        <TextBlock x:Name="lblBidCountdown" Text="" FontSize="14" FontWeight="Bold" Foreground="#f59e0b" Margin="8,0,0,0"/>
 </StackPanel>
     </Border>
    </Grid>
         </Border>

        <!-- OFFER TILE -->
          <Border x:Name="offerTile" Grid.Column="2" 
   Background="{StaticResource Brush.TileGradient}"
      BorderBrush="#1e293b" BorderThickness="1"
          CornerRadius="0,4,4,0" Cursor="Hand"
 MouseLeftButtonUp="OfferTile_Click">
       <Grid Margin="16">
               <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
         <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
           <TextBlock x:Name="lblOfferLabel" Text="CLICK TO RFQ" 
       FontSize="10" FontWeight="Bold" Foreground="#64748b" HorizontalAlignment="Right"/>
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock x:Name="lblOfferValue" Text="RFQ" 
       FontSize="48" FontWeight="Bold" Foreground="#64748b" HorizontalAlignment="Center"/>
         <TextBlock x:Name="lblOfferSecondary" Text="" 
             FontSize="11" Foreground="#64748b" HorizontalAlignment="Center" Margin="0,4,0,0" Visibility="Collapsed"/>
         </StackPanel>
        <Border Grid.Row="2" HorizontalAlignment="Right" Padding="8,4" CornerRadius="4"
Background="#1e3a5f" x:Name="offerLPPanel" Visibility="Collapsed">
    <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="lblOfferCountdown" Text="" FontSize="14" Foreground="#94a3b8"/>
     <TextBlock x:Name="lblOfferLP" Text="" FontSize="14" FontWeight="Bold" Foreground="White" Margin="8,0,0,0"/>
  </StackPanel>
          </Border>
       </Grid>
            </Border>

     <!-- Spread Indicator -->
         <Border x:Name="spreadPanel" Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,8"
     Background="#0b0d10" Padding="8,4" CornerRadius="4"
        BorderBrush="#1e293b" BorderThickness="1" HorizontalAlignment="Center" Visibility="Collapsed">
        <TextBlock x:Name="lblSpread" Text="0.35" FontSize="14" FontWeight="Bold" Foreground="White"/>
     </Border>
        </Grid>

           <!-- COMBINED CONTROL BAR: Ladder toggle + Price Display -->
<Border Background="#14161b" BorderBrush="#1e293b" BorderThickness="1" CornerRadius="4" Margin="0,0,0,1">
   <Grid Height="28">
<Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
   <ColumnDefinition Width="*"/>
  <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
  
     <!-- Left: Ladder toggle -->
       <StackPanel Orientation="Horizontal" Margin="12,0" Cursor="Hand" MouseLeftButtonUp="LadderHeader_Click">
    <TextBlock x:Name="lblLadderArrow" Text="&#x25BC;" FontSize="10" Foreground="#64748b" 
      VerticalAlignment="Center" Margin="0,0,6,0"/>
          <TextBlock x:Name="lblLPCount" Text="4 LPs" FontSize="10" FontWeight="Bold" Foreground="#64748b" 
      VerticalAlignment="Center"/>
 </StackPanel>
  
        <!-- Right: Price Display dropdown -->
    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,12,0">
  <TextBlock Text="Price Display" FontSize="10" Foreground="#64748b" VerticalAlignment="Center" Margin="0,0,8,0"/>
  <ComboBox x:Name="cmbPriceDisplay" Background="#14161b" Foreground="#3b82f6" FontSize="10" FontWeight="Bold"
       BorderThickness="0" SelectedIndex="0">
      <ComboBoxItem Content="VOL"/>
    <ComboBoxItem Content="Premium"/>
       <ComboBoxItem Content="EUR Pips"/>
         <ComboBoxItem Content="USD Pips"/>
     </ComboBox>
   </StackPanel>
    </Grid>
</Border>

       <!-- LP LADDER (Collapsible) - with integrated LP checkboxes -->
     <Border x:Name="ladderBorder" Background="#14161b" BorderBrush="#1e293b" BorderThickness="1" CornerRadius="4" Margin="0,0,0,8">
<StackPanel x:Name="ladderContent">
     <!-- Ladder Header -->
    <Grid Background="#1a1d23" Height="28">
     <Grid.ColumnDefinitions>
<ColumnDefinition Width="*"/>
       <ColumnDefinition Width="60"/>
         <ColumnDefinition Width="*"/>
 </Grid.ColumnDefinitions>
        <TextBlock Text="YOU REC" FontSize="10" FontWeight="Bold" Foreground="#64748b"
  HorizontalAlignment="Center" VerticalAlignment="Center"/>
     <Border Grid.Column="1" BorderBrush="#1e293b" BorderThickness="1,0">
   <TextBlock Text="VENUE" FontSize="10" FontWeight="Bold" Foreground="#64748b"
         HorizontalAlignment="Center" VerticalAlignment="Center"/>
   </Border>
      <TextBlock Grid.Column="2" Text="YOU PAY" FontSize="10" FontWeight="Bold" Foreground="#64748b"
      HorizontalAlignment="Center" VerticalAlignment="Center"/>
  </Grid>
         
<!-- LP Rows -->
  <ItemsControl x:Name="lpLadder">
       <ItemsControl.ItemTemplate>
     <DataTemplate>
         <Border BorderBrush="#1e293b" BorderThickness="0,0,0,1">
          <Grid Height="48" Background="Transparent" Opacity="{Binding Opacity}">
   <Grid.ColumnDefinitions>
           <ColumnDefinition Width="*"/>
       <ColumnDefinition Width="60"/>
 <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
           
       <!-- Bid Side -->
    <Border Grid.Column="0" BorderBrush="{Binding BidBorderBrush}" BorderThickness="2,0,0,0" Background="{Binding BidBackground}">
       <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="{Binding BidVol}" FontSize="14" FontWeight="Medium" Foreground="{Binding BidForeground}" HorizontalAlignment="Center"/>
  <TextBlock Text="{Binding BidSecondary}" FontSize="10" Foreground="#64748b" HorizontalAlignment="Center"/>
  </StackPanel>
       </Border>
       
          <!-- LP Name + Checkbox (Center) -->
  <Border Grid.Column="1" Background="#0f1114" BorderBrush="#1e293b" BorderThickness="1,0">
<StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
 <TextBlock Text="{Binding LPName}" FontSize="11" FontWeight="Bold" 
            Foreground="{Binding LPForeground}" HorizontalAlignment="Center"/>
      <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" HorizontalAlignment="Center" Margin="0,2,0,0"
         Checked="LPCheckbox_Changed" Unchecked="LPCheckbox_Changed"/>
 </StackPanel>
    </Border>
 
 <!-- Offer Side -->
     <Border Grid.Column="2" BorderBrush="{Binding OfferBorderBrush}" BorderThickness="0,0,2,0" Background="{Binding OfferBackground}">
  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="{Binding OfferVol}" FontSize="14" FontWeight="Medium" Foreground="{Binding OfferForeground}" HorizontalAlignment="Center"/>
      <TextBlock Text="{Binding OfferSecondary}" FontSize="10" Foreground="#64748b" HorizontalAlignment="Center"/>
      </StackPanel>
    </Border>
         </Grid>
     </Border>
       </DataTemplate>
      </ItemsControl.ItemTemplate>
   </ItemsControl>
     
        <!-- Empty state / Initial LPs when no quotes -->
     <StackPanel x:Name="initialLPPanel">
         <!-- Row template for initial LPs -->
        <Border BorderBrush="#1e293b" BorderThickness="0,0,0,1">
    <Grid Height="48" Background="Transparent" Opacity="0.6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
  <ColumnDefinition Width="60"/>
       <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
     <TextBlock Text="--" FontSize="14" Foreground="#334155" HorizontalAlignment="Center"/>
                </StackPanel>
     <Border Grid.Column="1" Background="#0f1114" BorderBrush="#1e293b" BorderThickness="1,0">
     <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
       <TextBlock Text="BNP" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
  <CheckBox x:Name="chkBNP" IsChecked="True" HorizontalAlignment="Center" Margin="0,2,0,0"/>
        </StackPanel>
                </Border>
         <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
<TextBlock Text="--" FontSize="14" Foreground="#334155" HorizontalAlignment="Center"/>
      </StackPanel>
             </Grid>
 </Border>
         <Border BorderBrush="#1e293b" BorderThickness="0,0,0,1">
     <Grid Height="48" Background="Transparent" Opacity="0.6">
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="*"/>
       <ColumnDefinition Width="60"/>
<ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
               <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
    <TextBlock Text="--" FontSize="14" Foreground="#334155" HorizontalAlignment="Center"/>
  </StackPanel>
    <Border Grid.Column="1" Background="#0f1114" BorderBrush="#1e293b" BorderThickness="1,0">
   <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
    <TextBlock Text="HSBC" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
<CheckBox x:Name="chkHSBC" IsChecked="True" HorizontalAlignment="Center" Margin="0,2,0,0"/>
 </StackPanel>
   </Border>
         <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
    <TextBlock Text="--" FontSize="14" Foreground="#334155" HorizontalAlignment="Center"/>
    </StackPanel>
         </Grid>
      </Border>
   <Border BorderBrush="#1e293b" BorderThickness="0,0,0,1">
      <Grid Height="48" Background="Transparent" Opacity="0.4">
        <Grid.ColumnDefinitions>
     <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="60"/>
    <ColumnDefinition Width="*"/>
  </Grid.ColumnDefinitions>
   <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
          <TextBlock Text="--" FontSize="14" Foreground="#334155" HorizontalAlignment="Center"/>
  </StackPanel>
        <Border Grid.Column="1" Background="#0f1114" BorderBrush="#1e293b" BorderThickness="1,0">
 <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
     <TextBlock Text="SOCGEN" FontSize="11" FontWeight="Bold" Foreground="#64748b" HorizontalAlignment="Center"/>
             <CheckBox x:Name="chkSOCGEN" IsChecked="False" HorizontalAlignment="Center" Margin="0,2,0,0"/>
            </StackPanel>
       </Border>
          <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
      <TextBlock Text="--" FontSize="14" Foreground="#334155" HorizontalAlignment="Center"/>
     </StackPanel>
     </Grid>
  </Border>
  <Border BorderBrush="#1e293b" BorderThickness="0,0,0,1">
 <Grid Height="48" Background="Transparent" Opacity="0.4">
     <Grid.ColumnDefinitions>
         <ColumnDefinition Width="*"/>
   <ColumnDefinition Width="60"/>
  <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
       <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
      <TextBlock Text="--" FontSize="14" Foreground="#334155" HorizontalAlignment="Center"/>
      </StackPanel>
        <Border Grid.Column="1" Background="#0f1114" BorderBrush="#1e293b" BorderThickness="1,0">
   <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
<TextBlock Text="MS" FontSize="11" FontWeight="Bold" Foreground="#64748b" HorizontalAlignment="Center"/>
  <CheckBox x:Name="chkMS" IsChecked="False" HorizontalAlignment="Center" Margin="0,2,0,0"/>
       </StackPanel>
         </Border>
           <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
      <TextBlock Text="--" FontSize="14" Foreground="#334155" HorizontalAlignment="Center"/>
    </StackPanel>
       </Grid>
      </Border>
        </StackPanel>
 
       <!-- Click to RFQ message -->
  <TextBlock x:Name="lblNoQuotes" Text="Click RFQ to request quotes from selected LPs" 
  FontSize="11" Foreground="#64748b" HorizontalAlignment="Center" Margin="0,12,0,12"/>
    </StackPanel>
        </Border>

           <!-- OPTION 1 DETAILS PANEL -->
   <Border Background="#152040" BorderBrush="#1e293b" BorderThickness="1" CornerRadius="4">
        <StackPanel>
                <!-- Option 1 Header -->
   <Grid Background="#1a2850" Cursor="Hand" MouseLeftButtonUp="OptionHeader_Click">
  <Grid.ColumnDefinitions>
   <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/>
         <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" Margin="12,8">
         <TextBlock x:Name="lblOptionArrow" Text="&#x25BC;" FontSize="10" Foreground="#94a3b8" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBlock Text="Option 1" FontSize="12" FontWeight="Bold" Foreground="#e2e8f0"/>
             <TextBlock Text=" >> Global" FontSize="10" Foreground="#64748b" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>
           <TextBlock Grid.Column="2" Text="+" FontSize="16" Foreground="#64748b" Cursor="Hand" 
VerticalAlignment="Center" Margin="0,0,12,0"
             MouseLeftButtonUp="AddLeg_Click" ToolTip="Add new option"/>
    </Grid>
        
         <!-- Option Details Content -->
 <StackPanel x:Name="optionContent" Background="#0f1114">
           <!-- Type -->
            <Grid Height="28">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
    <ColumnDefinition Width="*"/>
           </Grid.ColumnDefinitions>
            <TextBlock Text="Type" FontSize="11" Foreground="#64748b" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <ComboBox x:Name="cmbOptionType" Grid.Column="1" Style="{StaticResource DarkComboBox}" SelectedIndex="0">
  <ComboBoxItem Content="Vanilla Option"/>
  <ComboBoxItem Content="Call Spread"/>
          <ComboBoxItem Content="Put Spread"/>
      <ComboBoxItem Content="Risk Reversal"/>
       </ComboBox>
            </Grid>
      <Border Height="1" Background="#1e293b"/>
            
      <!-- Quantity -->
        <Grid Height="28">
           <Grid.ColumnDefinitions>
 <ColumnDefinition Width="100"/>
          <ColumnDefinition Width="60"/>
        <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
               <TextBlock Text="Quantity" FontSize="11" Foreground="#64748b" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
     <ComboBox x:Name="cmbNotionalCcy" Grid.Column="1" Style="{StaticResource DarkComboBox}" SelectedIndex="0">
                  <ComboBoxItem Content="EUR"/>
              <ComboBoxItem Content="USD"/>
           </ComboBox>
                <TextBox x:Name="txtNotional" Grid.Column="2" Text="10,000,000" Style="{StaticResource DarkTextBox}"
        FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
                 </Grid>
  <Border Height="1" Background="#1e293b"/>
 
             <!-- Option Type (Call/Put) -->
                  <Grid Height="28">
            <Grid.ColumnDefinitions>
         <ColumnDefinition Width="100"/>
      <ColumnDefinition Width="*"/>
             </Grid.ColumnDefinitions>
   <TextBlock Text="Option Type" FontSize="11" Foreground="#64748b" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
  <ComboBox x:Name="cmbCallPut" Grid.Column="1" Style="{StaticResource DarkComboBox}" SelectedIndex="0">
      <ComboBoxItem Content="EUR Call / USD Put"/>
         <ComboBoxItem Content="EUR Put / USD Call"/>
 </ComboBox>
        </Grid>
   <Border Height="1" Background="#1e293b"/>
         
               <!-- Expiry Date -->
             <Grid Height="28">
          <Grid.ColumnDefinitions>
    <ColumnDefinition Width="100"/>
          <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
       </Grid.ColumnDefinitions>
                  <TextBlock Text="Expiry Date" FontSize="11" Foreground="#64748b" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
  <TextBox x:Name="txtExpiryDate" Grid.Column="1" Text="14 Jan 26" Style="{StaticResource DarkTextBox}"
              HorizontalAlignment="Right" VerticalAlignment="Center"/>
  <ComboBox x:Name="cmbTenor" Grid.Column="2" Style="{StaticResource DarkComboBox}" Foreground="#3b82f6" FontWeight="Medium"
           SelectedIndex="0" Margin="8,0,8,0" SelectionChanged="Tenor_Changed">
 <ComboBoxItem Content="1M"/>
     <ComboBoxItem Content="2M"/>
        <ComboBoxItem Content="3M"/>
             <ComboBoxItem Content="6M"/>
            <ComboBoxItem Content="1Y"/>
   </ComboBox>
      </Grid>
            <Border Height="1" Background="#1e293b"/>
         
    <!-- Strike -->
    <Grid Height="28">
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="100"/>
       <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
    <TextBlock Text="Strike" FontSize="11" Foreground="#64748b" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
           <TextBox x:Name="txtStrike" Grid.Column="1" Text="1.1751" Style="{StaticResource DarkTextBox}"
    Foreground="#facc15" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
        </Grid>
   <Border Height="1" Background="#1e293b"/>
         
      <!-- Expiry Cut -->
          <Grid Height="28">
        <Grid.ColumnDefinitions>
 <ColumnDefinition Width="100"/>
        <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
              <TextBlock Text="Expiry Cut" FontSize="11" Foreground="#64748b" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
           <ComboBox x:Name="cmbExpiryCut" Grid.Column="1" Style="{StaticResource DarkComboBox}" SelectedIndex="0">
    <ComboBoxItem Content="NYC"/>
        <ComboBoxItem Content="TKY"/>
              <ComboBoxItem Content="LON"/>
        </ComboBox>
      </Grid>
          <Border Height="1" Background="#1e293b"/>
         
             <!-- Delta Exchange -->
     <Grid Height="28">
  <Grid.ColumnDefinitions>
         <ColumnDefinition Width="100"/>
        <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
      <TextBlock Text="Delta Exchange" FontSize="11" Foreground="#64748b" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <ComboBox x:Name="cmbDeltaExchange" Grid.Column="1" Style="{StaticResource DarkComboBox}" Foreground="#3b82f6" SelectedIndex="0">
     <ComboBoxItem Content="No Hedge (Live)"/>
        <ComboBoxItem Content="Spot Hedge"/>
      <ComboBoxItem Content="Forward Hedge"/>
           </ComboBox>
   </Grid>
                 <Border Height="1" Background="#1e293b"/>
           
         <!-- Premium Due -->
       <Grid Height="28">
  <Grid.ColumnDefinitions>
   <ColumnDefinition Width="100"/>
  <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
        <TextBlock Text="Premium Due" FontSize="11" Foreground="#64748b" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
  <ComboBox x:Name="cmbPremiumDue" Grid.Column="1" Style="{StaticResource DarkComboBox}" SelectedIndex="0">
           <ComboBoxItem Content="SPOT"/>
              <ComboBoxItem Content="FORWARD"/>
           </ComboBox>
                </Grid>
  <Border Height="1" Background="#1e293b"/>
            
   <!-- Premium (calculated) -->
         <Grid Height="28" Background="#14161b">
      <Grid.ColumnDefinitions>
     <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
 </Grid.ColumnDefinitions>
<TextBlock Text="Premium" FontSize="11" Foreground="#64748b" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0">
   <TextBlock x:Name="lblPremiumBid" Text="RCV --" FontSize="10" Foreground="#64748b" VerticalAlignment="Center"/>
          <TextBlock Text=" / " FontSize="10" Foreground="#334155" VerticalAlignment="Center"/>
      <TextBlock x:Name="lblPremiumOffer" Text="PAY --" FontSize="10" Foreground="White" FontWeight="Medium" VerticalAlignment="Center"/>
        </StackPanel>
      </Grid>
     <Border Height="1" Background="#1e293b"/>
         
       <!-- Volatility (calculated) -->
     <Grid Height="28" Background="#14161b">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="100"/>
        <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
             <TextBlock Text="Volatility" FontSize="11" Foreground="#64748b" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
       <TextBlock x:Name="lblVolatility" Grid.Column="1" Text="-- / --" FontSize="11" Foreground="White" FontWeight="Medium"
         HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
        </Grid>
          </StackPanel>
     </StackPanel>
         </Border>
              </StackPanel>
   </ScrollViewer>

            <!-- RIGHT: Main content area (with toggle for deals panel) -->
            <Grid Grid.Column="1" Margin="8,0,0,0">
        <Grid.ColumnDefinitions>
         <ColumnDefinition Width="*"/>
           <ColumnDefinition x:Name="dealsPanelColumn" Width="380"/>
                </Grid.ColumnDefinitions>
    
             <!-- Center area -->
     <Border Grid.Column="0" Background="#0b0d10">
  <TextBlock Text="Trade visualization area" FontSize="11" Foreground="#334155" 
     HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
              
      <!-- DEALS PANEL (Collapsible) -->
  <Border x:Name="dealsPanel" Grid.Column="1" Background="#0b0d10" BorderBrush="#1e293b" BorderThickness="1,0,0,0">
 <Grid>
  <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
           <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

  <!-- Header with collapse button -->
     <Grid Background="#0b0d10">
   <Grid.ColumnDefinitions>
             <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
  </Grid.ColumnDefinitions>
       <TextBlock x:Name="lblDealsArrow" Text="&#x25B6;" FontSize="10" Foreground="#64748b" 
     VerticalAlignment="Center" Margin="12,8" Cursor="Hand"
       MouseLeftButtonUp="DealsHeader_Click"/>
             <TextBlock Grid.Column="1" Text="CONFIRMED DEALS" FontSize="12" FontWeight="Bold" Foreground="#94a3b8" 
           VerticalAlignment="Center" Margin="0,8"/>
 </Grid>

   <!-- Column Headers -->
 <Grid Grid.Row="1" Background="#1a1d23" Height="32">
         <Grid.ColumnDefinitions>
    <ColumnDefinition Width="60"/>
                 <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="50"/>
 <ColumnDefinition Width="45"/>
     <ColumnDefinition Width="80"/>
        </Grid.ColumnDefinitions>
      <TextBlock Text="TIME" FontSize="10" FontWeight="Bold" Foreground="#64748b" VerticalAlignment="Center" Margin="12,0,0,0"/>
         <TextBlock Grid.Column="1" Text="INSTRUMENT" FontSize="10" FontWeight="Bold" Foreground="#64748b" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="2" Text="LP" FontSize="10" FontWeight="Bold" Foreground="#64748b" VerticalAlignment="Center"/>
                 <TextBlock Grid.Column="3" Text="SIDE" FontSize="10" FontWeight="Bold" Foreground="#64748b" VerticalAlignment="Center"/>
   </Grid>

             <!-- Deal Cards -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
  <StackPanel>
    <TextBlock x:Name="lblNoDeals" Text="No trades yet. Execute a trade to see it here." 
      FontSize="11" Foreground="#64748b" HorizontalAlignment="Center" Margin="0,40" Visibility="Visible"/>
   
  <ItemsControl x:Name="dealCards">
  <ItemsControl.ItemTemplate>
   <DataTemplate>
               <Border BorderBrush="#1e293b" BorderThickness="0,0,0,1" Background="#14161b" Cursor="Hand"
            MouseLeftButtonUp="DealCard_Click">
              <StackPanel>
             <!-- Collapsed Row -->
   <Grid Height="44" Margin="12,0">
    <Grid.ColumnDefinitions>
               <ColumnDefinition Width="60"/>
          <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="50"/>
 <ColumnDefinition Width="45"/>
           <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>
                
  <TextBlock Text="{Binding Time}" FontFamily="JetBrains Mono, Consolas"
        FontSize="11" Foreground="#94a3b8" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="{Binding Instrument}" 
         FontSize="11" FontWeight="Medium" Foreground="White" VerticalAlignment="Center"/>
  <TextBlock Grid.Column="2" Text="{Binding LP}" 
               FontSize="10" FontWeight="Bold" Foreground="#3b82f6" VerticalAlignment="Center"/>
   <TextBlock Grid.Column="3" Text="{Binding Side}" 
             FontSize="10" FontWeight="Bold" Foreground="{Binding SideColor}" VerticalAlignment="Center"/>
    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
    <Border CornerRadius="2" Padding="6,2" Background="{Binding StatusBackground}">
     <TextBlock Text="{Binding Status}" FontSize="9" FontWeight="Bold" Foreground="{Binding StatusForeground}"/>
      </Border>
    <TextBlock Text="&#x25B6;" FontSize="10" Foreground="#64748b" Margin="6,0,0,0" VerticalAlignment="Center"/>
       </StackPanel>
        </Grid>

            <!-- Expanded Details -->
         <Border Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}"
             Background="#0f1114" Margin="12,0,12,12" Padding="12" CornerRadius="4">
       <StackPanel>
         <TextBlock Text="PRICING" FontSize="9" FontWeight="Bold" Foreground="#64748b" Margin="0,0,0,8"/>
        <Grid>
 <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
    <StackPanel>
     <StackPanel Orientation="Horizontal">
        <TextBlock Text="Vol" Width="60" FontSize="11" Foreground="#64748b"/>
  <TextBlock Text="{Binding Volatility}" FontSize="11" Foreground="White"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
  <TextBlock Text="EUR Pips" Width="60" FontSize="11" Foreground="#64748b"/>
    <TextBlock Text="{Binding EurPips}" FontSize="11" Foreground="White"/>
            </StackPanel>
            </StackPanel>
        <StackPanel Grid.Column="1">
    <StackPanel Orientation="Horizontal">
       <TextBlock Text="Premium" Width="60" FontSize="11" Foreground="#64748b"/>
    <TextBlock FontSize="11" FontWeight="Bold" Foreground="{Binding PremiumColor}">
 <Run Text="{Binding PremiumLabel, Mode=OneWay}"/>
         <Run Text=" EUR "/>
             <Run Text="{Binding PremiumDisplay, Mode=OneWay}"/>
           </TextBlock>
      </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
          <TextBlock Text="Spot" Width="60" FontSize="11" Foreground="#64748b"/>
       <TextBlock Text="{Binding SpotRate}" FontSize="11" Foreground="White"/>
       </StackPanel>
       </StackPanel>
         </Grid>
    <Border Height="1" Background="#1e293b" Margin="0,12"/>
             <TextBlock Text="TRADE DETAILS" FontSize="9" FontWeight="Bold" Foreground="#64748b" Margin="0,0,0,8"/>
   <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
     <ColumnDefinition Width="*"/>
  </Grid.ColumnDefinitions>
 <StackPanel>
        <StackPanel Orientation="Horizontal">
         <TextBlock Text="Strike" Width="60" FontSize="11" Foreground="#64748b"/>
        <TextBlock Text="{Binding Strike}" FontSize="11" FontWeight="Bold" Foreground="#facc15"/>
       </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
         <TextBlock Text="Expiry" Width="60" FontSize="11" Foreground="#64748b"/>
          <TextBlock Text="{Binding ExpiryDate}" FontSize="11" Foreground="#3b82f6"/>
             </StackPanel>
       </StackPanel>
     <StackPanel Grid.Column="1">
        <StackPanel Orientation="Horizontal">
           <TextBlock Text="Notional" Width="60" FontSize="11" Foreground="#64748b"/>
   <TextBlock Text="{Binding Notional}" FontSize="11" Foreground="White"/>
</StackPanel>
           <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
    <TextBlock Text="ExpCut" Width="60" FontSize="11" Foreground="#64748b"/>
       <TextBlock Text="{Binding ExpiryCut}" FontSize="11" Foreground="White"/>
 </StackPanel>
     </StackPanel>
           </Grid>
            <Border Height="1" Background="#1e293b" Margin="0,12"/>
           <Grid>
       <TextBlock Text="{Binding OrderId}" FontSize="10" FontFamily="JetBrains Mono, Consolas" Foreground="#64748b"/>
    <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold" Foreground="{Binding StatusForeground}" HorizontalAlignment="Right"/>
          </Grid>
         </StackPanel>
     </Border>
      </StackPanel>
    </Border>
           </DataTemplate>
             </ItemsControl.ItemTemplate>
                </ItemsControl>
         </StackPanel>
         </ScrollViewer>
    </Grid>
          </Border>
      </Grid>
        </Grid>
      
        <!-- DEALS TAB HANDLE (visible when panel is collapsed) -->
  <Border x:Name="dealsTabHandle" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,120,0,0"
                Background="#1e293b" CornerRadius="4,0,0,4" Padding="4,8" Cursor="Hand"
                MouseLeftButtonUp="DealsTabHandle_Click" Visibility="Collapsed">
            <StackPanel>
     <TextBlock Text="&#x25C0;" FontSize="10" Foreground="#94a3b8" HorizontalAlignment="Center"/>
        <TextBlock Text="D" FontSize="10" FontWeight="Bold" Foreground="#94a3b8"/>
  <TextBlock Text="E" FontSize="10" FontWeight="Bold" Foreground="#94a3b8"/>
                <TextBlock Text="A" FontSize="10" FontWeight="Bold" Foreground="#94a3b8"/>
                <TextBlock Text="L" FontSize="10" FontWeight="Bold" Foreground="#94a3b8"/>
       <TextBlock Text="S" FontSize="10" FontWeight="Bold" Foreground="#94a3b8"/>
       </StackPanel>
        </Border>
</Grid>
</Window>
