<Window x:Class="FXOAiTranslate.WPF.Views.FXAggregatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:FXOAiTranslate.WPF.Converters"
        mc:Ignorable="d"
        Title="FX Aggregator" 
        Height="700" Width="450"
        WindowStartupLocation="CenterScreen"
        Background="#FF0B0D10">

    <Window.Resources>
    <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="/FXOAiTranslate.WPF;component/Styles/Colors.xaml"/>
    </ResourceDictionary.MergedDictionaries>

   <!-- Converters -->
      <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>

     <!-- Timer State to Color Converter -->
  <Style x:Key="TimerText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="10"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
       <Setter Property="Foreground" Value="{StaticResource Brush.Green}"/>
            <Style.Triggers>
       <DataTrigger Binding="{Binding TimerState}" Value="Aging">
              <Setter Property="Foreground" Value="{StaticResource Brush.Amber}"/>
     </DataTrigger>
        <DataTrigger Binding="{Binding TimerState}" Value="Warning">
     <Setter Property="Foreground" Value="{StaticResource Brush.Amber}"/>
              </DataTrigger>
          <DataTrigger Binding="{Binding TimerState}" Value="Urgent">
         <Setter Property="Foreground" Value="{StaticResource Brush.Red}"/>
   </DataTrigger>
  <DataTrigger Binding="{Binding TimerState}" Value="Expired">
     <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}"/>
           </DataTrigger>
       </Style.Triggers>
            </Style>

            <!-- LP Row Template -->
    <DataTemplate x:Key="LPRowTemplate">
   <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" 
          Opacity="{Binding RowOpacity}" Height="48">
        <Grid>
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*"/>
 <ColumnDefinition Width="60"/>
  <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

   <!-- BID Column -->
   <Border Grid.Column="0" Padding="8,4">
   <Border.Style>
<Style TargetType="Border">
        <Style.Triggers>
<DataTrigger Binding="{Binding IsBestBid}" Value="True">
       <Setter Property="Background" Value="{StaticResource Brush.BestBidGradient}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Brush.Blue}"/>
      <Setter Property="BorderThickness" Value="2,0,0,0"/>
   </DataTrigger>
       </Style.Triggers>
    </Style>
       </Border.Style>
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
   <TextBlock Text="{Binding BidDisplay, Mode=OneWay}" FontSize="14" FontWeight="Medium"
        Foreground="{StaticResource Brush.TextMain}" HorizontalAlignment="Center"/>
   <TextBlock HorizontalAlignment="Center" FontSize="10" Foreground="{StaticResource Brush.TextDim}">
     <Run Text="{Binding NotionalDisplay, Mode=OneWay}"/>
 <Run Text=" | "/>
    <Run Text="{Binding DeltaDisplay, Mode=OneWay}"/>
     </TextBlock>
    </StackPanel>
       </Border>

    <!-- LP Name Column (middle) -->
            <Border Grid.Column="1" Background="{StaticResource Brush.PanelDark}" 
     BorderBrush="{StaticResource Brush.Border}" BorderThickness="1,0">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
 <TextBlock Text="{Binding LPName, Mode=OneWay}" FontSize="11" FontWeight="Bold"
    Foreground="{StaticResource Brush.TextMain}" HorizontalAlignment="Center"/>
      <TextBlock Text="{Binding TimerDisplay, Mode=OneWay}" Style="{StaticResource TimerText}" 
    HorizontalAlignment="Center" Margin="0,2,0,0"/>
            <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
  HorizontalAlignment="Center" Margin="0,2,0,0"/>
    </StackPanel>
 </Border>

  <!-- OFFER Column -->
  <Border Grid.Column="2" Padding="8,4">
     <Border.Style>
         <Style TargetType="Border">
 <Style.Triggers>
   <DataTrigger Binding="{Binding IsBestOffer}" Value="True">
     <Setter Property="Background" Value="{StaticResource Brush.BestOfferGradient}"/>
       <Setter Property="BorderBrush" Value="{StaticResource Brush.Blue}"/>
  <Setter Property="BorderThickness" Value="0,0,2,0"/>
           </DataTrigger>
         </Style.Triggers>
  </Style>
   </Border.Style>
     <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
 <TextBlock Text="{Binding OfferDisplay, Mode=OneWay}" FontSize="14" FontWeight="Bold"
       Foreground="{StaticResource Brush.TextMain}" HorizontalAlignment="Center"/>
     <TextBlock HorizontalAlignment="Center" FontSize="10" Foreground="{StaticResource Brush.TextDim}">
     <Run Text="{Binding NotionalDisplay, Mode=OneWay}"/>
    <Run Text=" | "/>
       <Run Text="{Binding DeltaDisplay, Mode=OneWay}"/>
   </TextBlock>
         </StackPanel>
       </Border>
        </Grid>
  </Border>
 </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
          <RowDefinition Height="180"/>
<RowDefinition Height="Auto"/>
  <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
 </Grid.RowDefinitions>

        <!-- Row 0: Trade Input -->
  <Border Grid.Row="0" Background="{StaticResource Brush.PanelDark}" 
        BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
            <Grid>
          <Grid.ColumnDefinitions>
       <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
       </Grid.ColumnDefinitions>
         <TextBox x:Name="TradeInputBox" Grid.Column="0" 
        Background="{StaticResource Brush.PanelDark}"
        Foreground="{StaticResource Brush.TextMain}"
           BorderBrush="{StaticResource Brush.Border}"
      Padding="8,6" FontSize="12"
       KeyDown="TradeInputBox_KeyDown"/>
 <Button x:Name="ParseButton" Grid.Column="1" Content="Parse" Margin="8,0,0,0" Padding="12,6"
       Background="{StaticResource Brush.BlueDark}"
      Foreground="{StaticResource Brush.Blue}"
     BorderThickness="0" Cursor="Hand"
              Click="ParseButton_Click"/>
    </Grid>
     </Border>

        <!-- Row 1: Hero Tiles (BID / OFFER) -->
      <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
       <ColumnDefinition Width="2"/>
   <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- BID Tile -->
            <Border Grid.Column="0" Background="{StaticResource Brush.TileGradient}"
    BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" 
       CornerRadius="4,0,0,4" Cursor="Hand" x:Name="BidTile" MouseLeftButtonDown="BidTile_Click">
  <Grid>
               <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
              <TextBlock Text="YOU REC" FontSize="10" FontWeight="Bold" 
Foreground="{StaticResource Brush.Green}" HorizontalAlignment="Center"
                   Visibility="{Binding IsRfqActive, Converter={StaticResource BoolToVis}}"/>
                  <TextBlock Text="CLICK TO RFQ" FontSize="10" FontWeight="Bold" 
          Foreground="{StaticResource Brush.TextDim}" HorizontalAlignment="Center"
            Visibility="{Binding IsRfqActive, Converter={StaticResource InverseBoolToVis}}"/>
                <TextBlock Text="{Binding BestBidDisplay}" FontSize="56" FontWeight="Bold"
   Foreground="{StaticResource Brush.TextMain}" HorizontalAlignment="Center"/>
  </StackPanel>
       
       <!-- LP + Timer badge -->
   <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="8,0,0,8"
           Background="{StaticResource Brush.BestBidGradient}" CornerRadius="4" Padding="8,4">
       <StackPanel Orientation="Horizontal">
           <TextBlock Text="{Binding BestBidLP}" FontSize="14" FontWeight="Bold" 
            Foreground="{StaticResource Brush.TextMain}"/>
         <TextBlock Text="{Binding BestBidTimerDisplay}" FontSize="14" FontWeight="Bold" 
     Foreground="{StaticResource Brush.Amber}" Margin="8,0,0,0"/>
        </StackPanel>
         </Border>
   </Grid>
         </Border>

   <!-- Spread indicator -->
      <Border Grid.Column="1" Background="{StaticResource Brush.Background}" VerticalAlignment="Bottom" 
        HorizontalAlignment="Center" Margin="0,0,0,8" Padding="8,4" CornerRadius="4"
           BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" Panel.ZIndex="10">
                <TextBlock Text="0.35" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Brush.TextMain}"/>
            </Border>

        <!-- OFFER Tile -->
            <Border Grid.Column="2" Background="{StaticResource Brush.TileGradient}"
      BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" 
 CornerRadius="0,4,4,0" Cursor="Hand" x:Name="OfferTile" MouseLeftButtonDown="OfferTile_Click">
       <Grid>
 <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
             <TextBlock Text="YOU PAY" FontSize="10" FontWeight="Bold" 
         Foreground="{StaticResource Brush.Red}" HorizontalAlignment="Center"
                    Visibility="{Binding IsRfqActive, Converter={StaticResource BoolToVis}}"/>
      <TextBlock Text="CLICK TO RFQ" FontSize="10" FontWeight="Bold" 
           Foreground="{StaticResource Brush.TextDim}" HorizontalAlignment="Center"
       Visibility="{Binding IsRfqActive, Converter={StaticResource InverseBoolToVis}}"/>
            <TextBlock Text="{Binding BestOfferDisplay}" FontSize="56" FontWeight="Bold"
             Foreground="{StaticResource Brush.TextMain}" HorizontalAlignment="Center"/>
       </StackPanel>
         
    <!-- LP + Timer badge -->
      <Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,8,8"
     Background="{StaticResource Brush.BestOfferGradient}" CornerRadius="4" Padding="8,4">
               <StackPanel Orientation="Horizontal">
           <TextBlock Text="{Binding BestOfferTimerDisplay}" FontSize="14" 
      Foreground="{StaticResource Brush.TextSub}" Margin="0,0,8,0"/>
         <TextBlock Text="{Binding BestOfferLP}" FontSize="14" FontWeight="Bold" 
             Foreground="{StaticResource Brush.TextMain}"/>
        </StackPanel>
          </Border>
     </Grid>
            </Border>
    </Grid>

        <!-- Row 2: LP Count / Price Display Toggle -->
        <Border Grid.Row="2" Background="{StaticResource Brush.PanelMid}" 
         BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="4" 
       Padding="12,6" Margin="0,0,0,4">
     <Grid>
           <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
   <TextBlock Text="?" FontSize="10" Foreground="{StaticResource Brush.TextDim}" VerticalAlignment="Center"/>
     <TextBlock Text="{Binding EnabledLPCount, StringFormat='{}{0} LPs'}" 
            FontSize="10" FontWeight="Bold" Foreground="{StaticResource Brush.TextDim}" 
         Margin="4,0,0,0" VerticalAlignment="Center"/>
      </StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <TextBlock Text="Price Display" FontSize="10" Foreground="{StaticResource Brush.TextDim}" VerticalAlignment="Center"/>
        <TextBlock Text="VOL" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Brush.Blue}" 
    Margin="8,0,0,0" VerticalAlignment="Center"/>
   </StackPanel>
  </Grid>
     </Border>

        <!-- Row 3: LP Ladder -->
     <Border Grid.Row="3" Background="{StaticResource Brush.PanelMid}" 
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,4">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
   </Grid.RowDefinitions>

  <!-- Ladder Header -->
       <Border Grid.Row="0" Background="{StaticResource Brush.HeaderBackground}" 
          BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,6">
         <Grid>
         <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*"/>
           <ColumnDefinition Width="60"/>
             <ColumnDefinition Width="*"/>
         </Grid.ColumnDefinitions>
     <TextBlock Grid.Column="0" Text="YOU REC" FontSize="10" FontWeight="Bold" 
      Foreground="{StaticResource Brush.TextDim}" HorizontalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="VENUE" FontSize="10" FontWeight="Bold" 
        Foreground="{StaticResource Brush.TextDim}" HorizontalAlignment="Center"/>
  <TextBlock Grid.Column="2" Text="YOU PAY" FontSize="10" FontWeight="Bold" 
        Foreground="{StaticResource Brush.TextDim}" HorizontalAlignment="Center"/>
    </Grid>
     </Border>

     <!-- LP Rows -->
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
<ItemsControl ItemsSource="{Binding LPQuotes}" 
      ItemTemplate="{StaticResource LPRowTemplate}"/>
         </ScrollViewer>
            </Grid>
   </Border>

    <!-- Row 4: Trade Details (Collapsible) -->
    <Expander Grid.Row="4" Header="Option 1" IsExpanded="True" 
        Foreground="{StaticResource Brush.TextMain}">
        <Border Background="{StaticResource Brush.PanelDark}" 
    BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" Padding="0">
    <StackPanel>
           <!-- Type -->
              <Grid Height="24">
   <Grid.ColumnDefinitions>
                 <ColumnDefinition Width="100"/>
     <ColumnDefinition Width="*"/>
  </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource Brush.PanelMid}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
           <TextBlock Text="Type" FontSize="11" Foreground="{StaticResource Brush.TextDim}" 
      VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
         </Border>
      <Border Grid.Column="1" Background="{StaticResource Brush.PanelDark}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
         <TextBlock Text="{Binding StructureName}" FontSize="11" Foreground="{StaticResource Brush.TextSub}" 
               VerticalAlignment="Center" Margin="8,0,0,0"/>
            </Border>
       </Grid>

     <!-- Quantity -->
      <Grid Height="24">
        <Grid.ColumnDefinitions>
    <ColumnDefinition Width="100"/>
   <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="{StaticResource Brush.PanelMid}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
      <TextBlock Text="Quantity" FontSize="11" Foreground="{StaticResource Brush.TextDim}" 
  VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
               </Border>
               <Border Grid.Column="1" Background="{StaticResource Brush.PanelDark}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
<TextBlock Text="{Binding BaseCurrency}" FontSize="11" Foreground="{StaticResource Brush.TextMain}"/>
        <TextBlock Text="{Binding NotionalDisplay}" FontSize="11" FontWeight="Bold" 
       Foreground="{StaticResource Brush.TextMain}" Margin="8,0,0,0"/>
      </StackPanel>
     </Border>
         </Grid>

          <!-- Option Type -->
   <Grid Height="24">
             <Grid.ColumnDefinitions>
<ColumnDefinition Width="100"/>
  <ColumnDefinition Width="*"/>
         </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource Brush.PanelMid}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
        <TextBlock Text="Option Type" FontSize="11" Foreground="{StaticResource Brush.TextDim}" 
          VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
            </Border>
  <Border Grid.Column="1" Background="{StaticResource Brush.PanelDark}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
     <TextBlock Text="{Binding OptionTypeDisplay}" FontSize="11" Foreground="{StaticResource Brush.TextSub}" 
    VerticalAlignment="Center" Margin="8,0,0,0"/>
          </Border>
</Grid>

    <!-- Expiry -->
     <Grid Height="24">
          <Grid.ColumnDefinitions>
    <ColumnDefinition Width="100"/>
   <ColumnDefinition Width="*"/>
               </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{StaticResource Brush.PanelMid}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
         <TextBlock Text="Expiry Date" FontSize="11" Foreground="{StaticResource Brush.TextDim}" 
            VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
           </Border>
              <Border Grid.Column="1" Background="{StaticResource Brush.PanelDark}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
         <TextBlock Text="{Binding Expiry}" FontSize="11" Foreground="{StaticResource Brush.TextMain}"/>
    <TextBlock Text="{Binding Tenor}" FontSize="11" Foreground="{StaticResource Brush.Blue}" 
        FontWeight="Medium" Margin="8,0,0,0"/>
         </StackPanel>
          </Border>
           </Grid>

          <!-- Strike -->
<Grid Height="24">
         <Grid.ColumnDefinitions>
     <ColumnDefinition Width="100"/>
     <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource Brush.PanelMid}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
 <TextBlock Text="Strike" FontSize="11" Foreground="{StaticResource Brush.TextDim}" 
       VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
          </Border>
      <Border Grid.Column="1" Background="{StaticResource Brush.PanelDark}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
          <TextBlock Text="{Binding StrikeDisplay}" FontSize="11" FontWeight="Bold" 
   Foreground="{StaticResource Brush.Yellow}" 
              VerticalAlignment="Center" Margin="8,0,0,0"/>
       </Border>
         </Grid>
         </StackPanel>
            </Border>
     </Expander>
    </Grid>
</Window>
