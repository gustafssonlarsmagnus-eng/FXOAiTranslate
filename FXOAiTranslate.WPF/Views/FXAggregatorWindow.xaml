<Window x:Class="FXOAiTranslate.WPF.Views.FXAggregatorWindow"
     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="FX Aggregator" 
     Height="850" Width="1100"
  WindowStartupLocation="CenterScreen"
        Background="#0b0d10"
        FontFamily="Inter, Segoe UI">

 <Window.Resources>
        <ResourceDictionary>
     <ResourceDictionary.MergedDictionaries>
           <ResourceDictionary Source="/FXOAiTranslate.WPF;component/Styles/Colors.xaml"/>
       <ResourceDictionary Source="/FXOAiTranslate.WPF;component/Styles/ButtonStyles.xaml"/>
        </ResourceDictionary.MergedDictionaries>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
   </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <!-- Main Content -->
        <Grid Margin="8,8,8,-308">
  <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
  <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

            <!-- LEFT: Quote Panel + Leg Details -->
 <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Column="0" Style="{StaticResource DarkScrollViewer}">
          <StackPanel>
               
        <!-- TRADE INPUT -->
     <Border Background="#0f1114" BorderBrush="#1e293b" BorderThickness="1" CornerRadius="4" Margin="0,0,0,8">
           <Grid>
   <!-- TextBox with extra right padding for button (thinner with 6px vertical padding) -->
           <TextBox x:Name="txtTradeInput"
   Style="{StaticResource DarkTextBox}"
  FontSize="14" Padding="12,6,80,6"
        Text=""
        Tag="E.g., buy 10mio EURUSD 1m call 1.18"
        GotFocus="txtTradeInput_GotFocus"
LostFocus="txtTradeInput_LostFocus"
        Loaded="txtTradeInput_Loaded"
      PreviewKeyDown="txtTradeInput_KeyDown"/>
        <!-- Parse button overlaid on the right (HTML style) -->
        <Button x:Name="btnParse" Content="Parse"
     HorizontalAlignment="Right" VerticalAlignment="Center"
     Margin="0,0,8,0" Padding="12,4"
  Background="#332563EB" Foreground="#60a5fa"
            BorderThickness="0" Cursor="Hand" FontWeight="Medium"
            FontSize="11"
           Click="ParseButton_Click">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="#332563EB"/>
                    <Setter Property="Foreground" Value="#60a5fa"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}"
                                        CornerRadius="4" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#4D2563EB"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
         </Border>

   <!-- EXECUTION TILES -->
    <Grid Height="200" Margin="0,0,0,8">
   <Grid.ColumnDefinitions>
<ColumnDefinition Width="*"/>
   <ColumnDefinition Width="2"/>
           <ColumnDefinition Width="*"/>
   </Grid.ColumnDefinitions>

      <!-- BID TILE -->
     <Border x:Name="bidTile" Grid.Column="0" 
 Background="{StaticResource Brush.TileGradient}"
      BorderBrush="#1e293b" BorderThickness="1"
       CornerRadius="4,0,0,4" Cursor="Hand"
    MouseLeftButtonUp="BidTile_Click"
MouseEnter="Tile_MouseEnter" MouseLeave="Tile_MouseLeave">
       <Grid Margin="16,16,16,40">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
  <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
   
  <!-- BID Label (top-left, hidden initially, shown when quoting) -->
     <TextBlock x:Name="lblBidLabel" Text="YOU REC" 
FontSize="10" FontWeight="Bold" Foreground="#22c55e" 
   Visibility="Collapsed" HorizontalAlignment="Left"/>
    
   <!-- Center Content -->
    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
 <!-- RFQ instruction label (shown in initial state) -->
     <TextBlock x:Name="lblBidRfqHint" Text="CLICK TO RFQ (F9)" 
        FontSize="10" FontWeight="Bold" Foreground="#64748b"
    HorizontalAlignment="Center" Margin="0,0,0,4"/>

  <TextBlock x:Name="lblBidValue" Text="RFQ"
    FontFamily="./Assets/Fonts/#Inter, Segoe UI" FontSize="72" FontWeight="Bold" Foreground="#64748b"
 HorizontalAlignment="Center" VerticalAlignment="Center"
TextOptions.TextFormattingMode="Display"
 TextOptions.TextRenderingMode="ClearType"
 MouseEnter="HeroValue_MouseEnter" MouseLeave="HeroValue_MouseLeave"/>
   <TextBlock x:Name="lblBidSecondary" Text=""
  FontSize="12" FontWeight="Bold" Foreground="#64748b"
      HorizontalAlignment="Center" Margin="0,8,0,0"
      Visibility="Collapsed"/>
   </StackPanel>
    </Grid>
</Border>

      <!-- OFFER TILE -->
   <Border x:Name="offerTile" Grid.Column="2" 
 Background="{StaticResource Brush.TileGradient}"
    BorderBrush="#1e293b" BorderThickness="1"
 CornerRadius="0,4,4,0" Cursor="Hand"
 MouseLeftButtonUp="OfferTile_Click"
 MouseEnter="Tile_MouseEnter" MouseLeave="Tile_MouseLeave">
<Grid Margin="16,16,16,40">
 <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
   </Grid.RowDefinitions>
      
      <!-- OFFER Label (top-right, hidden initially, shown when quoting) -->
    <TextBlock x:Name="lblOfferLabel" Text="YOU PAY" 
     FontSize="10" FontWeight="Bold" Foreground="#ef4444" HorizontalAlignment="Right"
    Visibility="Collapsed"/>
    
       <!-- Center Content -->
  <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
          <!-- RFQ instruction label (shown in initial state) -->
  <TextBlock x:Name="lblOfferRfqHint" Text="CLICK TO RFQ (F9)" 
  FontSize="10" FontWeight="Bold" Foreground="#64748b"
   HorizontalAlignment="Center" Margin="0,0,0,4"/>
       
    <TextBlock x:Name="lblOfferValue" Text="RFQ"
  FontFamily="./Assets/Fonts/#Inter, Segoe UI" FontSize="72" FontWeight="Bold" Foreground="#64748b" HorizontalAlignment="Center"
  TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    MouseEnter="HeroValue_MouseEnter" MouseLeave="HeroValue_MouseLeave"/>
   <TextBlock x:Name="lblOfferSecondary" Text=""
    FontSize="12" FontWeight="Bold" Foreground="#64748b"
HorizontalAlignment="Center" Margin="0,8,0,0" Visibility="Collapsed"/>
</StackPanel>
    </Grid>
      </Border>

     <!-- Bottom Bar: LP Badges + Spread (all aligned at same baseline) -->
     <Grid Grid.ColumnSpan="3" VerticalAlignment="Bottom" Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
<ColumnDefinition Width="*"/>
<ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- Bid LP Badge (left side) -->
        <Border Grid.Column="0" HorizontalAlignment="Left"
       Padding="12,6" CornerRadius="4"
 Background="{StaticResource Brush.LPBadgeBid}" 
             x:Name="bidLPPanel" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
     <TextBlock x:Name="lblBidLP" Text="" FontSize="18" FontWeight="Bold" Foreground="White" MinWidth="50"/>
     <TextBlock x:Name="lblBidCountdown" Text="" FontSize="18" FontWeight="Bold" Foreground="#f59e0b" Margin="8,0,0,0"/>
            </StackPanel>
        </Border>
     
        <!-- Spread Indicator (center) -->
        <Border x:Name="spreadPanel" Grid.Column="1" HorizontalAlignment="Center"
        Background="#0b0d10" Padding="12,4" CornerRadius="4"
             BorderBrush="#1e293b" BorderThickness="1" Visibility="Collapsed">
      <TextBlock x:Name="lblSpread" Text="" FontSize="18" FontWeight="Bold" Foreground="White"/>
        </Border>
        
        <!-- Offer LP Badge (right side) -->
    <Border Grid.Column="2" HorizontalAlignment="Right"
    Padding="12,6" CornerRadius="4"
        Background="{StaticResource Brush.LPBadgeOffer}" 
     x:Name="offerLPPanel" Visibility="Collapsed">
      <StackPanel Orientation="Horizontal">
   <TextBlock x:Name="lblOfferCountdown" Text="" FontSize="18" FontWeight="Bold" Foreground="#f59e0b"/>
  <TextBlock x:Name="lblOfferLP" Text="" FontSize="18" FontWeight="Bold" Foreground="White" Margin="8,0,0,0" MinWidth="50" TextAlignment="Right"/>
       </StackPanel>
        </Border>
     </Grid>
</Grid>

    <!-- COMBINED CONTROL BAR: Ladder toggle + STOP RFQ + Price Display -->
<Border Background="#14161b" BorderBrush="#1e293b" BorderThickness="1" CornerRadius="4" Margin="0,0,0,1">
   <Grid Height="28">
<Grid.ColumnDefinitions>
  <ColumnDefinition Width="Auto"/>
   <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
</Grid.ColumnDefinitions>

     <!-- Left: Ladder toggle -->
  <StackPanel Orientation="Horizontal" Margin="12,0" Cursor="Hand" MouseLeftButtonUp="LadderHeader_Click">
  <TextBlock x:Name="lblLadderArrow" Text="&#x25BC;" FontSize="10" Foreground="#64748b" 
VerticalAlignment="Center" Margin="0,0,6,0"/>
  <TextBlock x:Name="lblLPCount" Text="3 LPs" FontSize="10" FontWeight="Bold" Foreground="#64748b" 
 VerticalAlignment="Center"/>
 </StackPanel>
  
  <!-- Center: STOP RFS Button (only shown when quoting) - spans all 3 columns for true centering -->
        <Button x:Name="btnStopRFQ" Grid.ColumnSpan="3" Content="⬛ STOP RFS"
            Visibility="Collapsed"
            Padding="12,4" FontSize="11" FontWeight="Medium"
            BorderThickness="0"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            Cursor="Hand" Click="CancelRFQ_Click">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="#332563EB"/>
                    <Setter Property="Foreground" Value="#60a5fa"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#4D2563EB"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>

        <!-- Right: Price Display dropdown -->
    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,12,0">
  <TextBlock Text="Price Display" FontSize="10" Foreground="#64748b" VerticalAlignment="Center" Margin="0,0,8,0"/>
  <ComboBox x:Name="cmbPriceDisplay" Style="{StaticResource DarkComboBox}" 
   Foreground="#3b82f6" FontSize="10" FontWeight="Bold" SelectedIndex="0">
      <ComboBoxItem Content="VOL"/>
    <ComboBoxItem Content="Premium"/>
  <ComboBoxItem Content="EUR Pips"/>
    <ComboBoxItem Content="USD Pips"/>
     </ComboBox>
   </StackPanel>
    </Grid>
</Border>

       <!-- LP LADDER (Collapsible) - with integrated LP checkboxes -->
     <Border x:Name="ladderBorder" Background="#14161b" BorderBrush="#1e293b" BorderThickness="1" CornerRadius="4" Margin="0,0,0,8">
<StackPanel x:Name="ladderContent">
     <!-- Ladder Header -->
    <Grid Background="#1a1d23" Height="28">
     <Grid.ColumnDefinitions>
<ColumnDefinition Width="*"/>
       <ColumnDefinition Width="70"/>
         <ColumnDefinition Width="*"/>
 </Grid.ColumnDefinitions>
     <TextBlock Text="YOU REC" FontSize="10" FontWeight="Bold" Foreground="#64748b"
  HorizontalAlignment="Center" VerticalAlignment="Center"/>
     <Border Grid.Column="1" BorderBrush="#1e293b" BorderThickness="1,0">
   <TextBlock Text="VENUE" FontSize="10" FontWeight="Bold" Foreground="#64748b"
         HorizontalAlignment="Center" VerticalAlignment="Center"/>
   </Border>
      <TextBlock Grid.Column="2" Text="YOU PAY" FontSize="10" FontWeight="Bold" Foreground="#64748b"
      HorizontalAlignment="Center" VerticalAlignment="Center"/>
  </Grid>
         
<!-- LP Rows -->
  <ItemsControl x:Name="lpLadder">
       <ItemsControl.ItemTemplate>
     <DataTemplate>
         <Border BorderBrush="#1e293b" BorderThickness="0,0,0,1">
          <Grid Height="48" Background="Transparent" Opacity="{Binding Opacity}">
   <Grid.ColumnDefinitions>
           <ColumnDefinition Width="*"/>
       <ColumnDefinition Width="70"/>
 <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
           
       <!-- Bid Side -->
    <Border Grid.Column="0" BorderBrush="{Binding BidBorderBrush}" BorderThickness="2,0,0,0" Background="{Binding BidBackground}">
       <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="{Binding BidVol}" FontSize="14" FontWeight="Medium" Foreground="{Binding BidForeground}" HorizontalAlignment="Center"/>
  <TextBlock Text="{Binding BidSecondary}" FontSize="10" Foreground="#64748b" HorizontalAlignment="Center"/>
  </StackPanel>
       </Border>
       
          <!-- LP Name + Checkbox (Center) -->
  <Border Grid.Column="1" Background="#0f1114" BorderBrush="#1e293b" BorderThickness="1,0"
          MouseEnter="LPName_MouseEnter" MouseLeave="LPName_MouseLeave">
<StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
 <TextBlock Text="{Binding LPName}" FontSize="11" FontWeight="Bold"
            Foreground="{Binding LPForeground}" HorizontalAlignment="Center"/>
      <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" HorizontalAlignment="Center" Margin="0,2,0,0"
         Checked="LPCheckbox_Changed" Unchecked="LPCheckbox_Changed" Style="{StaticResource DarkCheckBox}"/>
 </StackPanel>
    </Border>
 
 <!-- Offer Side -->
     <Border Grid.Column="2" BorderBrush="{Binding OfferBorderBrush}" BorderThickness="0,0,2,0" Background="{Binding OfferBackground}">
  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="{Binding OfferVol}" FontSize="14" FontWeight="Medium" Foreground="{Binding OfferForeground}" HorizontalAlignment="Center"/>
      <TextBlock Text="{Binding OfferSecondary}" FontSize="10" Foreground="#64748b" HorizontalAlignment="Center"/>
      </StackPanel>
    </Border>
         </Grid>
     </Border>
       </DataTemplate>
      </ItemsControl.ItemTemplate>
   </ItemsControl>
     
        <!-- Empty state / Initial LPs when no quotes (from FenicsConfig) -->
     <StackPanel x:Name="initialLPPanel">
  
  <!-- MS - Morgan Stanley -->
     <Border BorderBrush="#1e293b" BorderThickness="0,0,0,1">
    <Grid Height="40" Background="Transparent" Opacity="0.9">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
  <ColumnDefinition Width="70"/>
  <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
   <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
     <TextBlock Text="" FontSize="14" Foreground="#334155" HorizontalAlignment="Center"/>
     </StackPanel>
     <Border Grid.Column="1" Background="#0f1114" BorderBrush="#1e293b" BorderThickness="1,0">
     <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
       <TextBlock Text="MS" FontSize="10" FontWeight="Bold" Foreground="#64748b" HorizontalAlignment="Center"/>
<CheckBox x:Name="chkMS" Style="{StaticResource DarkCheckBox}" IsChecked="False" HorizontalAlignment="Center" Margin="0,2,0,0"
  Checked="LPCheckbox_Changed" Unchecked="LPCheckbox_Changed"/>
        </StackPanel>
    </Border>
 <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
  <TextBlock Text="" FontSize="14" Foreground="#334155" HorizontalAlignment="Center"/>
      </StackPanel>
</Grid>
 </Border>

  <!-- HSBC -->
   <Border BorderBrush="#1e293b" BorderThickness="0,0,0,1">
     <Grid Height="40" Background="Transparent" Opacity="0.9">
 <Grid.ColumnDefinitions>
  <ColumnDefinition Width="*"/>
 <ColumnDefinition Width="70"/>
     <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
    <TextBlock Text="" FontSize="14" Foreground="#334155" HorizontalAlignment="Center"/>
  </StackPanel>
    <Border Grid.Column="1" Background="#0f1114" BorderBrush="#1e293b" BorderThickness="1,0">
   <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
  <TextBlock Text="HSBC" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
<CheckBox x:Name="chkHSBC" Style="{StaticResource DarkCheckBox}" IsChecked="True" HorizontalAlignment="Center" Margin="0,2,0,0"
     Checked="LPCheckbox_Changed" Unchecked="LPCheckbox_Changed"/>
 </StackPanel>
   </Border>
  <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
  <TextBlock Text="" FontSize="14" Foreground="#334155" HorizontalAlignment="Center"/>
    </StackPanel>
    </Grid>
  </Border>

  <!-- BNP - BNP Paribas -->
   <Border BorderBrush="#1e293b" BorderThickness="0,0,0,1">
    <Grid Height="40" Background="Transparent" Opacity="0.9">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
  <ColumnDefinition Width="70"/>
   <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
 <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
     <TextBlock Text="" FontSize="14" Foreground="#334155" HorizontalAlignment="Center"/>
    </StackPanel>
     <Border Grid.Column="1" Background="#0f1114" BorderBrush="#1e293b" BorderThickness="1,0">
     <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
  <TextBlock Text="BNP" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
  <CheckBox x:Name="chkBNP" Style="{StaticResource DarkCheckBox}" IsChecked="True" HorizontalAlignment="Center" Margin="0,2,0,0"
   Checked="LPCheckbox_Changed" Unchecked="LPCheckbox_Changed"/>
        </StackPanel>
 </Border>
   <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
<TextBlock Text="" FontSize="14" Foreground="#334155" HorizontalAlignment="Center"/>
    </StackPanel>
       </Grid>
 </Border>

  <!-- NATWEST - NatWest Markets -->
   <Border BorderBrush="#1e293b" BorderThickness="0,0,0,1">
      <Grid Height="40" Background="Transparent" Opacity="0.4">
      <Grid.ColumnDefinitions>
   <ColumnDefinition Width="*"/>
    <ColumnDefinition Width="70"/>
    <ColumnDefinition Width="*"/>
  </Grid.ColumnDefinitions>
   <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
 <TextBlock Text="" FontSize="14" Foreground="#334155" HorizontalAlignment="Center"/>
  </StackPanel>
  <Border Grid.Column="1" Background="#0f1114" BorderBrush="#1e293b" BorderThickness="1,0">
 <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
  <TextBlock Text="NATWEST" FontSize="9" FontWeight="Bold" Foreground="#64748b" HorizontalAlignment="Center"/>
      <CheckBox x:Name="chkNATWEST" Style="{StaticResource DarkCheckBox}" IsChecked="False" HorizontalAlignment="Center" Margin="0,2,0,0"
     Checked="LPCheckbox_Changed" Unchecked="LPCheckbox_Changed"/>
     </StackPanel>
     </Border>
  <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
<TextBlock Text="" FontSize="14" Foreground="#334155" HorizontalAlignment="Center"/>
     </StackPanel>
     </Grid>
  </Border>

  <!-- SOCGEN - Societe Generale -->
  <Border BorderBrush="#1e293b" BorderThickness="0,0,0,1">
 <Grid Height="40" Background="Transparent" Opacity="0.4">
     <Grid.ColumnDefinitions>
         <ColumnDefinition Width="*"/>
   <ColumnDefinition Width="70"/>
<ColumnDefinition Width="*"/>
</Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
      <TextBlock Text="" FontSize="14" Foreground="#334155" HorizontalAlignment="Center"/>
      </StackPanel>
   <Border Grid.Column="1" Background="#0f1114" BorderBrush="#1e293b" BorderThickness="1,0">
   <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
<TextBlock Text="SOCGEN" FontSize="9" FontWeight="Bold" Foreground="#64748b" HorizontalAlignment="Center"/>
  <CheckBox x:Name="chkSOCGEN" Style="{StaticResource DarkCheckBox}" IsChecked="False" HorizontalAlignment="Center" Margin="0,2,0,0"
     Checked="LPCheckbox_Changed" Unchecked="LPCheckbox_Changed"/>
       </StackPanel>
  </Border>
      <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
      <TextBlock Text="" FontSize="14" Foreground="#334155" HorizontalAlignment="Center"/>
    </StackPanel>
 </Grid>
</Border>

  <!-- CIBC - Canadian Imperial Bank -->
  <Border BorderBrush="#1e293b" BorderThickness="0,0,0,1">
 <Grid Height="40" Background="Transparent" Opacity="0.4">
 <Grid.ColumnDefinitions>
   <ColumnDefinition Width="*"/>
   <ColumnDefinition Width="70"/>
  <ColumnDefinition Width="*"/>
     </Grid.ColumnDefinitions>
  <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
      <TextBlock Text="" FontSize="14" Foreground="#334155" HorizontalAlignment="Center"/>
      </StackPanel>
   <Border Grid.Column="1" Background="#0f1114" BorderBrush="#1e293b" BorderThickness="1,0">
   <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
<TextBlock Text="CIBC" FontSize="10" FontWeight="Bold" Foreground="#64748b" HorizontalAlignment="Center"/>
  <CheckBox x:Name="chkCIBC" Style="{StaticResource DarkCheckBox}" IsChecked="False" HorizontalAlignment="Center" Margin="0,2,0,0"
     Checked="LPCheckbox_Changed" Unchecked="LPCheckbox_Changed"/>
     </StackPanel>
   </Border>
  <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
      <TextBlock Text="" FontSize="14" Foreground="#334155" HorizontalAlignment="Center"/>
    </StackPanel>
 </Grid>
</Border>

  <!-- SCBL - Standard Chartered -->
  <Border BorderBrush="#1e293b" BorderThickness="0,0,0,1">
 <Grid Height="40" Background="Transparent" Opacity="0.4">
     <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*"/>
   <ColumnDefinition Width="70"/>
  <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
  <TextBlock Text="" FontSize="14" Foreground="#334155" HorizontalAlignment="Center"/>
      </StackPanel>
   <Border Grid.Column="1" Background="#0f1114" BorderBrush="#1e293b" BorderThickness="1,0">
   <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
<TextBlock Text="SCBL" FontSize="10" FontWeight="Bold" Foreground="#64748b" HorizontalAlignment="Center"/>
  <CheckBox x:Name="chkSCBL" Style="{StaticResource DarkCheckBox}" IsChecked="False" HorizontalAlignment="Center" Margin="0,2,0,0"
     Checked="LPCheckbox_Changed" Unchecked="LPCheckbox_Changed"/>
       </StackPanel>
     </Border>
      <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
      <TextBlock Text="" FontSize="14" Foreground="#334155" HorizontalAlignment="Center"/>
    </StackPanel>
 </Grid>
</Border>

  <!-- NOMURA -->
  <Border BorderBrush="#1e293b" BorderThickness="0,0,0,1">
 <Grid Height="40" Background="Transparent" Opacity="0.4">
     <Grid.ColumnDefinitions>
       <ColumnDefinition Width="*"/>
   <ColumnDefinition Width="70"/>
  <ColumnDefinition Width="*"/>
 </Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
      <TextBlock Text="" FontSize="14" Foreground="#334155" HorizontalAlignment="Center"/>
   </StackPanel>
   <Border Grid.Column="1" Background="#0f1114" BorderBrush="#1e293b" BorderThickness="1,0">
   <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
<TextBlock Text="NOMURA" FontSize="9" FontWeight="Bold" Foreground="#64748b" HorizontalAlignment="Center"/>
  <CheckBox x:Name="chkNOMURA" Style="{StaticResource DarkCheckBox}" IsChecked="False" HorizontalAlignment="Center" Margin="0,2,0,0"
     Checked="LPCheckbox_Changed" Unchecked="LPCheckbox_Changed"/>
   </StackPanel>
     </Border>
  <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
  <TextBlock Text="" FontSize="14" Foreground="#334155" HorizontalAlignment="Center"/>
    </StackPanel>
 </Grid>
</Border>

  <!-- BAML - Bank of America -->
  <Border BorderBrush="#1e293b" BorderThickness="0,0,0,1">
 <Grid Height="40" Background="Transparent" Opacity="0.4">
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
   <ColumnDefinition Width="70"/>
  <ColumnDefinition Width="*"/>
  </Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
    <TextBlock Text="" FontSize="14" Foreground="#334155" HorizontalAlignment="Center"/>
      </StackPanel>
   <Border Grid.Column="1" Background="#0f1114" BorderBrush="#1e293b" BorderThickness="1,0">
   <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
<TextBlock Text="BAML" FontSize="10" FontWeight="Bold" Foreground="#64748b" HorizontalAlignment="Center"/>
  <CheckBox x:Name="chkBAML" Style="{StaticResource DarkCheckBox}" IsChecked="False" HorizontalAlignment="Center" Margin="0,2,0,0"
     Checked="LPCheckbox_Changed" Unchecked="LPCheckbox_Changed"/>
  </StackPanel>
     </Border>
      <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
 <TextBlock Text="" FontSize="14" Foreground="#334155" HorizontalAlignment="Center"/>
    </StackPanel>
 </Grid>
</Border>
