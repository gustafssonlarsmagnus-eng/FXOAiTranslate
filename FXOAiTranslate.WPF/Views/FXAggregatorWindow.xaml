<Window x:Class="FXOAiTranslate.WPF.Views.FXAggregatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="FX Aggregator" 
        Height="850" Width="920"
        WindowStartupLocation="CenterScreen"
        Background="#0b0d10"
        FontFamily="Inter, Segoe UI">

    <Window.Resources>
        <ResourceDictionary>
  <ResourceDictionary.MergedDictionaries>
         <ResourceDictionary Source="/FXOAiTranslate.WPF;component/Styles/Colors.xaml"/>
   <ResourceDictionary Source="/FXOAiTranslate.WPF;component/Styles/ButtonStyles.xaml"/>
  </ResourceDictionary.MergedDictionaries>
    
   <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.ColumnDefinitions>
   <ColumnDefinition Width="420"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

    <!-- LEFT: Quote Panel -->
        <StackPanel Grid.Column="0">
       
          <!-- TRADE INPUT -->
  <Border Background="#0f1114" BorderBrush="#1e293b" BorderThickness="1" CornerRadius="4" Margin="0,0,0,8">
                <Grid Margin="12,8">
              <TextBox x:Name="txtTradeInput" 
         Background="Transparent" BorderThickness="0"
        Foreground="#e2e8f0" FontSize="13"
          VerticalAlignment="Center"
        Text="buy 10M EURUSD 1M call 1.18"/>
          <Button Content="Parse" 
  HorizontalAlignment="Right"
         Padding="12,4"
         Background="#1e3a5f" Foreground="#3b82f6"
          BorderThickness="0" Cursor="Hand"
        Click="ParseButton_Click"/>
         </Grid>
    </Border>

   <!-- EXECUTION TILES -->
            <Grid Height="200" Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
     <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="2"/>
     <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

       <!-- BID TILE -->
    <Border x:Name="bidTile" Grid.Column="0" 
      Background="{StaticResource Brush.TileGradient}"
        BorderBrush="#1e293b" BorderThickness="1"
            CornerRadius="4,0,0,4" Cursor="Hand"
      MouseLeftButtonUp="BidTile_Click">
         <Grid Margin="16">
   <Grid.RowDefinitions>
         <RowDefinition Height="Auto"/>
                 <RowDefinition Height="*"/>
         <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
        
                <!-- Label -->
      <TextBlock x:Name="lblBidLabel" Text="CLICK TO RFQ" 
   FontSize="10" FontWeight="Bold" 
       Foreground="#64748b"/>
               
  <!-- Price -->
               <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
       <TextBlock x:Name="lblBidValue" Text="RFQ" 
    FontSize="48" FontWeight="Bold" Foreground="#64748b"
          HorizontalAlignment="Center"/>
       <TextBlock x:Name="lblBidSecondary" Text="" 
       FontSize="11" Foreground="#64748b"
         HorizontalAlignment="Center" Margin="0,4,0,0"
        Visibility="Collapsed"/>
  </StackPanel>
         
   <!-- LP + Countdown -->
            <Border Grid.Row="2" HorizontalAlignment="Left" Padding="8,4" CornerRadius="4"
    Background="#1e3a5f" x:Name="bidLPPanel" Visibility="Collapsed">
         <StackPanel Orientation="Horizontal">
       <TextBlock x:Name="lblBidLP" Text="" 
        FontSize="14" FontWeight="Bold" Foreground="White"/>
     <TextBlock x:Name="lblBidCountdown" Text="" 
      FontSize="14" FontWeight="Bold" Foreground="#f59e0b"
          Margin="8,0,0,0"/>
        </StackPanel>
</Border>
  </Grid>
        </Border>

   <!-- OFFER TILE -->
             <Border x:Name="offerTile" Grid.Column="2" 
                Background="{StaticResource Brush.TileGradient}"
  BorderBrush="#1e293b" BorderThickness="1"
          CornerRadius="0,4,4,0" Cursor="Hand"
         MouseLeftButtonUp="OfferTile_Click">
    <Grid Margin="16">
     <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
       </Grid.RowDefinitions>
       
   <!-- Label -->
       <TextBlock x:Name="lblOfferLabel" Text="CLICK TO RFQ" 
    FontSize="10" FontWeight="Bold" 
     Foreground="#64748b" HorizontalAlignment="Right"/>
 
               <!-- Price -->
     <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
       <TextBlock x:Name="lblOfferValue" Text="RFQ" 
     FontSize="48" FontWeight="Bold" Foreground="#64748b"
  HorizontalAlignment="Center"/>
   <TextBlock x:Name="lblOfferSecondary" Text="" 
     FontSize="11" Foreground="#64748b"
      HorizontalAlignment="Center" Margin="0,4,0,0"
          Visibility="Collapsed"/>
         </StackPanel>
   
            <!-- LP + Countdown -->
             <Border Grid.Row="2" HorizontalAlignment="Right" Padding="8,4" CornerRadius="4"
             Background="#1e3a5f" x:Name="offerLPPanel" Visibility="Collapsed">
          <StackPanel Orientation="Horizontal">
    <TextBlock x:Name="lblOfferCountdown" Text="" 
   FontSize="14" Foreground="#94a3b8"/>
             <TextBlock x:Name="lblOfferLP" Text="" 
            FontSize="14" FontWeight="Bold" Foreground="White"
   Margin="8,0,0,0"/>
                </StackPanel>
         </Border>
         </Grid>
    </Border>

        <!-- Spread Indicator -->
                <Border x:Name="spreadPanel" Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,8"
       Background="#0b0d10" Padding="8,4" CornerRadius="4"
   BorderBrush="#1e293b" BorderThickness="1"
             HorizontalAlignment="Center" Visibility="Collapsed">
          <TextBlock x:Name="lblSpread" Text="0.35" 
     FontSize="14" FontWeight="Bold" Foreground="White"/>
        </Border>
  </Grid>

            <!-- LP LADDER -->
            <Border Background="#14161b" BorderBrush="#1e293b" BorderThickness="1" CornerRadius="4">
        <StackPanel>
        <!-- Header -->
         <Grid Background="#1a1d23" Height="32">
  <Grid.ColumnDefinitions>
             <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="70"/>
       <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
       <TextBlock Text="YOU REC" FontSize="10" FontWeight="Bold" Foreground="#64748b"
               HorizontalAlignment="Center" VerticalAlignment="Center"/>
  <TextBlock Grid.Column="1" Text="VENUE" FontSize="10" FontWeight="Bold" Foreground="#64748b"
HorizontalAlignment="Center" VerticalAlignment="Center"/>
       <TextBlock Grid.Column="2" Text="YOU PAY" FontSize="10" FontWeight="Bold" Foreground="#64748b"
            HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
           
<!-- LP Rows -->
          <ItemsControl x:Name="lpLadder">
 <ItemsControl.ItemTemplate>
    <DataTemplate>
            <Border BorderBrush="#1e293b" BorderThickness="0,0,0,1">
         <Grid Height="48" Background="Transparent" Opacity="{Binding Opacity}">
          <Grid.ColumnDefinitions>
   <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="70"/>
 <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
          
      <!-- Bid -->
            <Border Grid.Column="0" 
      BorderBrush="{Binding BidBorderBrush}" 
     BorderThickness="2,0,0,0"
     Background="{Binding BidBackground}">
             <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
           <TextBlock Text="{Binding BidVol}" 
   FontSize="14" FontWeight="Medium" Foreground="White"
                HorizontalAlignment="Center"/>
   <TextBlock Text="{Binding BidSecondary}" 
        FontSize="10" Foreground="#64748b"
    HorizontalAlignment="Center"/>
</StackPanel>
    </Border>
    
       <!-- LP Name -->
         <Border Grid.Column="1" Background="#0f1114" 
BorderBrush="#1e293b" BorderThickness="1,0">
  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
    <TextBlock Text="{Binding LPName}" 
         FontSize="11" FontWeight="Bold" Foreground="White"
          HorizontalAlignment="Center"/>
   <CheckBox IsChecked="{Binding IsEnabled}" 
             HorizontalAlignment="Center" Margin="0,2,0,0"/>
        </StackPanel>
          </Border>
      
      <!-- Offer -->
        <Border Grid.Column="2" 
     BorderBrush="{Binding OfferBorderBrush}" 
    BorderThickness="0,0,2,0"
             Background="{Binding OfferBackground}">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="{Binding OfferVol}" 
         FontSize="14" FontWeight="Medium" Foreground="White"
       HorizontalAlignment="Center"/>
     <TextBlock Text="{Binding OfferSecondary}" 
           FontSize="10" Foreground="#64748b"
         HorizontalAlignment="Center"/>
    </StackPanel>
          </Border>
               </Grid>
     </Border>
              </DataTemplate>
        </ItemsControl.ItemTemplate>
            </ItemsControl>
          
            <!-- Empty state -->
 <TextBlock x:Name="lblNoQuotes" Text="Click RFQ to request quotes from LPs" 
      FontSize="11" Foreground="#64748b" 
       HorizontalAlignment="Center" Margin="0,20"/>
    </StackPanel>
            </Border>
      </StackPanel>

        <!-- RIGHT: Deal Cards Panel -->
        <Border Grid.Column="1" Margin="8,0,0,0" 
     Background="#0b0d10" BorderBrush="#1e293b" BorderThickness="1,0,0,0">
            <Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
  <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
     </Grid.RowDefinitions>

     <!-- Header -->
  <TextBlock Text="CONFIRMED DEALS" 
             FontSize="12" FontWeight="Bold" Foreground="#94a3b8"
      Margin="12,8"/>

    <!-- Column Headers -->
   <Grid Grid.Row="1" Background="#1a1d23" Height="32">
         <Grid.ColumnDefinitions>
   <ColumnDefinition Width="60"/>
    <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="50"/>
        <ColumnDefinition Width="45"/>
            <ColumnDefinition Width="80"/>
           </Grid.ColumnDefinitions>
     <TextBlock Text="TIME" FontSize="10" FontWeight="Bold" Foreground="#64748b" 
      VerticalAlignment="Center" Margin="12,0,0,0"/>
          <TextBlock Grid.Column="1" Text="INSTRUMENT" FontSize="10" FontWeight="Bold" Foreground="#64748b" 
         VerticalAlignment="Center"/>
  <TextBlock Grid.Column="2" Text="LP" FontSize="10" FontWeight="Bold" Foreground="#64748b" 
  VerticalAlignment="Center"/>
   <TextBlock Grid.Column="3" Text="SIDE" FontSize="10" FontWeight="Bold" Foreground="#64748b" 
     VerticalAlignment="Center"/>
      </Grid>

             <!-- Deal Cards -->
  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <StackPanel>
            <!-- Empty State -->
  <TextBlock x:Name="lblNoDeals" Text="No trades yet. Execute a trade to see it here." 
               FontSize="11" Foreground="#64748b" 
          HorizontalAlignment="Center" Margin="0,40"
    Visibility="Visible"/>
    
         <ItemsControl x:Name="dealCards">
              <ItemsControl.ItemTemplate>
  <DataTemplate>
         <Border BorderBrush="#1e293b" BorderThickness="0,0,0,1" 
      Background="#14161b" Cursor="Hand"
         MouseLeftButtonUp="DealCard_Click">
     <StackPanel>
   <!-- Collapsed Row -->
           <Grid Height="44" Margin="12,0">
         <Grid.ColumnDefinitions>
        <ColumnDefinition Width="60"/>
          <ColumnDefinition Width="*"/>
 <ColumnDefinition Width="50"/>
  <ColumnDefinition Width="45"/>
          <ColumnDefinition Width="80"/>
                  </Grid.ColumnDefinitions>
      
         <TextBlock Text="{Binding Time}" 
               FontFamily="JetBrains Mono, Consolas"
        FontSize="11" Foreground="#94a3b8"
    VerticalAlignment="Center"/>
  <TextBlock Grid.Column="1" Text="{Binding Instrument}" 
                 FontSize="11" FontWeight="Medium" Foreground="White"
         VerticalAlignment="Center"/>
 <TextBlock Grid.Column="2" Text="{Binding LP}" 
      FontSize="10" FontWeight="Bold" Foreground="#3b82f6"
                  VerticalAlignment="Center"/>
        <TextBlock Grid.Column="3" Text="{Binding Side}" 
            FontSize="10" FontWeight="Bold" 
             Foreground="{Binding SideColor}"
  VerticalAlignment="Center"/>
  <StackPanel Grid.Column="4" Orientation="Horizontal" 
 VerticalAlignment="Center" HorizontalAlignment="Right">
         <Border CornerRadius="2" Padding="6,2"
  Background="{Binding StatusBackground}">
        <TextBlock Text="{Binding Status}" 
      FontSize="9" FontWeight="Bold"
  Foreground="{Binding StatusForeground}"/>
          </Border>
                  <TextBlock x:Name="arrow" Text="?" FontSize="10" Foreground="#64748b" 
            Margin="6,0,0,0" VerticalAlignment="Center"/>
       </StackPanel>
              </Grid>

            <!-- Expanded Details -->
             <Border Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}"
         Background="#0f1114" Margin="12,0,12,12" Padding="12" CornerRadius="4">
               <StackPanel>
    <!-- Pricing Section -->
           <TextBlock Text="PRICING" FontSize="9" FontWeight="Bold" 
         Foreground="#64748b" Margin="0,0,0,8"/>
      <Grid>
      <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
        <StackPanel>
        <StackPanel Orientation="Horizontal">
     <TextBlock Text="Vol" Width="60" FontSize="11" Foreground="#64748b"/>
      <TextBlock Text="{Binding Volatility}" FontSize="11" Foreground="White"/>
       </StackPanel>
     <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
   <TextBlock Text="EUR Pips" Width="60" FontSize="11" Foreground="#64748b"/>
       <TextBlock Text="{Binding EurPips}" FontSize="11" Foreground="White"/>
 </StackPanel>
</StackPanel>
      <StackPanel Grid.Column="1">
          <StackPanel Orientation="Horizontal">
   <TextBlock Text="Premium" Width="60" FontSize="11" Foreground="#64748b"/>
  <TextBlock FontSize="11" FontWeight="Bold" Foreground="{Binding PremiumColor}">
      <Run Text="{Binding PremiumLabel, Mode=OneWay}"/>
     <Run Text=" EUR "/>
    <Run Text="{Binding PremiumDisplay, Mode=OneWay}"/>
       </TextBlock>
  </StackPanel>
         <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
       <TextBlock Text="Spot" Width="60" FontSize="11" Foreground="#64748b"/>
          <TextBlock Text="{Binding SpotRate}" FontSize="11" Foreground="White"/>
                </StackPanel>
      </StackPanel>
  </Grid>

 <!-- Divider -->
         <Border Height="1" Background="#1e293b" Margin="0,12"/>

             <!-- Trade Details -->
        <TextBlock Text="TRADE DETAILS" FontSize="9" FontWeight="Bold" 
            Foreground="#64748b" Margin="0,0,0,8"/>
          <Grid>
      <Grid.ColumnDefinitions>
 <ColumnDefinition Width="*"/>
           <ColumnDefinition Width="*"/>
   </Grid.ColumnDefinitions>
                  <StackPanel>
    <StackPanel Orientation="Horizontal">
        <TextBlock Text="Strike" Width="60" FontSize="11" Foreground="#64748b"/>
              <TextBlock Text="{Binding Strike}" FontSize="11" 
       FontWeight="Bold" Foreground="#facc15"/>
        </StackPanel>
     <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
         <TextBlock Text="Expiry" Width="60" FontSize="11" Foreground="#64748b"/>
<TextBlock Text="{Binding ExpiryDate}" FontSize="11" 
               Foreground="#3b82f6"/>
       </StackPanel>
               </StackPanel>
 <StackPanel Grid.Column="1">
       <StackPanel Orientation="Horizontal">
   <TextBlock Text="Notional" Width="60" FontSize="11" Foreground="#64748b"/>
            <TextBlock Text="{Binding Notional}" FontSize="11" Foreground="White"/>
     </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
<TextBlock Text="ExpCut" Width="60" FontSize="11" Foreground="#64748b"/>
           <TextBlock Text="{Binding ExpiryCut}" FontSize="11" Foreground="White"/>
    </StackPanel>
          </StackPanel>
         </Grid>

      <!-- Divider -->
               <Border Height="1" Background="#1e293b" Margin="0,12"/>

     <!-- Order ID -->
       <Grid>
          <TextBlock Text="{Binding OrderId}" FontSize="10" 
       FontFamily="JetBrains Mono, Consolas"
             Foreground="#64748b"/>
    <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold"
      Foreground="{Binding StatusForeground}"
 HorizontalAlignment="Right"/>
</Grid>
   </StackPanel>
          </Border>
  </StackPanel>
   </Border>
              </DataTemplate>
         </ItemsControl.ItemTemplate>
        </ItemsControl>
              </StackPanel>
     </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
