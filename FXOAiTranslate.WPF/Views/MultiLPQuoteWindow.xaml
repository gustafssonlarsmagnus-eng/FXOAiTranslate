<Window x:Class="FXOAiTranslate.WPF.Views.MultiLPQuoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="FX Option Aggregator"
        Height="750" Width="1400"
        MinHeight="650" MinWidth="1200"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.AppBackground}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FXOAiTranslate.WPF;component/Styles/Colors.xaml"/>
                <ResourceDictionary Source="/FXOAiTranslate.WPF;component/Styles/ButtonStyles.xaml"/>
                <ResourceDictionary Source="/FXOAiTranslate.WPF;component/Styles/GridStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title -->
            <RowDefinition Height="140"/>  <!-- Top Execution Buttons -->
            <RowDefinition Height="*"/>    <!-- Data Grid -->
            <RowDefinition Height="Auto"/> <!-- Bottom Parameters -->
        </Grid.RowDefinitions>

        <!-- ============================================ -->
        <!-- ENHANCED HEADER WITH TRADE DETAILS           -->
        <!-- ============================================ -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <!-- Main Title: EURUSD CALL -->
            <TextBlock Text="{Binding TradeTitle}"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{StaticResource Brush.TextMain}"
                       Margin="0,0,0,5"/>

            <!-- Trade Details Row -->
            <TextBlock FontSize="12"
                       Foreground="{StaticResource Brush.TextSub}"
                       Margin="0,0,0,3">
                <Run Text="10M EUR"/>
                <Run Text=" • "/>
                <Run Text="Strike 1.1720"/>
                <Run Text=" • "/>
                <Run Text="25 Days"/>
            </TextBlock>

            <!-- Market Data Row -->
            <TextBlock FontSize="11"
                       Foreground="{StaticResource Brush.TextDim}">
                <Run Text="Spot Ref: 1.16769"/>
                <Run Text=" | "/>
                <Run Text="Trade Date: 11-Dec-2025"/>
            </TextBlock>
        </StackPanel>

        <!-- ============================================ -->
        <!-- TOP PANEL: BEST EXECUTION BUTTONS            -->
        <!-- ============================================ -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/> <!-- Spacer -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- BID TILE (Left - You Sell) -->
            <Border Grid.Column="0"
                    Style="{StaticResource BidButtonBorder}">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding ExecuteBidCommand}"/>
                </Border.InputBindings>

                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="BID"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource Brush.TextDim}"
                                       Margin="0,0,0,2"/>
                            <TextBlock Text="YOU SELL"
                                       Style="{StaticResource ButtonHeaderText}"/>
                        </StackPanel>
                        <Border Style="{StaticResource BankTag}"
                                HorizontalAlignment="Right">
                            <TextBlock Text="{Binding BestBidBank}"
                                       Style="{StaticResource BankNameText}"/>
                        </Border>
                    </Grid>

                    <!-- Big Premium -->
                    <TextBlock Grid.Row="1"
                               Text="{Binding BestBidPremiumFormatted}"
                               Style="{StaticResource BigPremiumText}"/>

                    <!-- Volatility -->
                    <TextBlock Grid.Row="2"
                               Text="{Binding BestBidVolatilityFormatted}"
                               Style="{StaticResource VolatilityText}"/>
                </Grid>
            </Border>

            <!-- OFFER TILE (Right - You Buy) -->
            <Border Grid.Column="2"
                    Style="{StaticResource OfferButtonBorder}">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding ExecuteOfferCommand}"/>
                </Border.InputBindings>

                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="OFFER"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource Brush.TextDim}"
                                       Margin="0,0,0,2"/>
                            <TextBlock Text="YOU BUY"
                                       Style="{StaticResource ButtonHeaderText}"/>
                        </StackPanel>
                        <Border Style="{StaticResource BankTag}"
                                HorizontalAlignment="Right">
                            <TextBlock Text="{Binding BestOfferBank}"
                                       Style="{StaticResource BankNameText}"/>
                        </Border>
                    </Grid>

                    <!-- Big Premium -->
                    <TextBlock Grid.Row="1"
                               Text="{Binding BestOfferPremiumFormatted}"
                               Style="{StaticResource BigPremiumText}"/>

                    <!-- Volatility -->
                    <TextBlock Grid.Row="2"
                               Text="{Binding BestOfferVolatilityFormatted}"
                               Style="{StaticResource VolatilityText}"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================================ -->
        <!-- MIDDLE PANEL: QUOTE GRID                     -->
        <!-- ============================================ -->
        <Border Grid.Row="2"
                Background="{StaticResource Brush.PanelBackground}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="3"
                Margin="0,0,0,15">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Request Quotes Button -->
                <Button Grid.Row="0"
                        Content="REQUEST FRESH QUOTES"
                        Command="{Binding RequestQuotesCommand}"
                        Background="{StaticResource Brush.TealMain}"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="12"
                        Height="35"
                        Margin="10,10,10,5"
                        Cursor="Hand"
                        BorderThickness="0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="2"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FF00A587"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Data Grid -->
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Quotes}"
                          Style="{StaticResource QuoteDataGrid}"
                          ColumnHeaderStyle="{StaticResource DataGridColumnHeader}"
                          RowStyle="{StaticResource QuoteDataGridRow}"
                          Margin="10">

                    <DataGrid.Columns>
                        <!-- Venue / Bank Name -->
                        <DataGridTextColumn Header="VENUE"
                                            Binding="{Binding BankName}"
                                            Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource BankNameCellText}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- BID (Premium / Vol Combined) -->
                        <DataGridTextColumn Header="BID"
                                            Binding="{Binding BidCombined}"
                                            Width="180">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeader}">
                                    <Setter Property="Background" Value="{StaticResource Brush.TealDark}"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource PremiumCellText}">
                                    <Setter Property="TextWrapping" Value="NoWrap"/>
                                    <Setter Property="LineHeight" Value="18"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- MID VOL (Keep as single value) -->
                        <DataGridTextColumn Header="MID VOL"
                                            Binding="{Binding MidVolFormatted}"
                                            Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource NumberCellText}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- ASK (Premium / Vol Combined) -->
                        <DataGridTextColumn Header="ASK"
                                            Binding="{Binding AskCombined}"
                                            Width="180">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeader}">
                                    <Setter Property="Background" Value="{StaticResource Brush.RedMain}"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource PremiumCellText}">
                                    <Setter Property="TextWrapping" Value="NoWrap"/>
                                    <Setter Property="LineHeight" Value="18"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- DELTA / SPOT (Combined) -->
                        <DataGridTextColumn Header="DELTA / SPOT"
                                            Binding="{Binding DeltaSpotCombined}"
                                            Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource NumberCellText}">
                                    <Setter Property="TextWrapping" Value="NoWrap"/>
                                    <Setter Property="LineHeight" Value="18"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ============================================ -->
        <!-- BOTTOM PANEL: TRADE PARAMETERS               -->
        <!-- ============================================ -->
        <Border Grid.Row="3"
                Background="{StaticResource Brush.HeaderBackground}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="2"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Trade ID -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="TRADE ID:"
                               Foreground="{StaticResource Brush.TextSub}"
                               FontSize="10"
                               Margin="0,0,5,0"/>
                    <TextBlock Text="TRD-12345"
                               Foreground="{StaticResource Brush.TextMain}"
                               FontSize="10"
                               FontWeight="Bold"/>
                </StackPanel>

                <!-- Structure Type -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="STRUCTURE:"
                               Foreground="{StaticResource Brush.TextSub}"
                               FontSize="10"
                               Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding TradeTitle}"
                               Foreground="{StaticResource Brush.TextMain}"
                               FontSize="10"
                               FontWeight="Bold"/>
                </StackPanel>

                <!-- Expiry -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="EXPIRY:"
                               Foreground="{StaticResource Brush.TextSub}"
                               FontSize="10"
                               Margin="0,0,5,0"/>
                    <TextBlock Text="17-Dec-25"
                               Foreground="{StaticResource Brush.TextMain}"
                               FontSize="10"
                               FontWeight="Bold"/>
                </StackPanel>

                <!-- Notional -->
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <TextBlock Text="NOTIONAL:"
                               Foreground="{StaticResource Brush.TextSub}"
                               FontSize="10"
                               Margin="0,0,5,0"/>
                    <TextBlock Text="10M EUR"
                               Foreground="{StaticResource Brush.TextMain}"
                               FontSize="10"
                               FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
