<Window x:Class="FXOAiTranslate.WPF.Views.MultiLPQuoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
            </ResourceDictionary.MergedDictionaries>

            <!-- Converter for Visibility -->
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        </ResourceDictionary>
    </Window.Resources>


        <!-- ============================================ -->
        <!-- ============================================ -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


                           FontSize="10"
        </Grid>

            <Grid.ColumnDefinitions>
            </Grid.ColumnDefinitions>

                        BorderThickness="1"
                        Cursor="Hand"
                    <Border.InputBindings>
                    </Border.InputBindings>

                        <Grid.RowDefinitions>
                        </Grid.RowDefinitions>

                                           FontSize="10"

                                               FontWeight="Bold"
                                               Foreground="{StaticResource Brush.MidnightTextDim}"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Top"/>
                                    <TextBlock Text="NO PRICE"
                                               FontFamily="{StaticResource Font.Mono}"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource Brush.MidnightTextDim}"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Bottom"/>
                                </Grid>
                            </Border>

                            <!-- Right: RFQ Button -->
                            <Border Grid.Column="1"
                                    Background="{StaticResource Brush.MidnightRFQButton}"
                                    Padding="16">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource Brush.MidnightRFQButton}"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{StaticResource Brush.MidnightHover}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="START"
                                                   FontFamily="{StaticResource Font.UI}"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource Brush.MidnightBlue}"
                                                   Opacity="0.5"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock Text="RFQ"
                                                   FontFamily="{StaticResource Font.UI}"
                                                   FontSize="48"
                                                   FontWeight="Bold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                                       HorizontalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>




                                       FontWeight="Bold"

                                         FontSize="12"
                        </Grid>
                    </Border>

                                       FontWeight="Bold"



                        </Grid>
                    </Border>


                        BorderThickness="1"

                        <!-- Header -->
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"

                            </Grid>
                        </Border>


                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Row 0: strategy -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="strategy" Foreground="#FFB08860" FontSize="11" Margin="0,2"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="EUR Call" Foreground="#FFDDDDDD" FontSize="11" Margin="0,2"/>

                            <!-- Row 1: dates -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="dates" Foreground="#FFB08860" FontSize="11" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="1M NYK 14 Jan 26" Foreground="#FFDDDDDD" FontSize="11" Margin="0,2"/>

                            <!-- Row 2: maturity -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="maturity" Foreground="#FFB08860" FontSize="11" Margin="0,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="1 Month" Foreground="#FF88CCDD" FontSize="11" Margin="0,2"/>

                            <!-- Row 3: cutoff -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="cutoff" Foreground="#FFB08860" FontSize="11" Margin="0,2"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="NYK" Foreground="#FFDDDDDD" FontSize="11" Margin="0,2"/>

                            <!-- Row 4: expiry -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="expiry" Foreground="#FFB08860" FontSize="11" Margin="0,2"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="14 Jan 26" Foreground="#FFDDDDDD" FontSize="11" Margin="0,2"/>

                            <!-- Row 5: delivery -->
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="delivery" Foreground="#FFB08860" FontSize="11" Margin="0,2"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="16 Jan 26" Foreground="#FFDDDDDD" FontSize="11" Margin="0,2"/>



                    </Grid>
                </Border>
            </Grid>

                    BorderThickness="1"

                <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                    </Grid.RowDefinitions>


                        </Grid>
                    </Border>


                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                    </Grid>
                                </Border>
                            </Grid>


                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Background="{StaticResource Brush.MidnightPropertyLeft}"
                                        BorderBrush="{StaticResource Brush.MidnightBorder}"
                                        BorderThickness="0,0,0,1"
                                        Padding="8,0">
                                    <TextBlock Text="Expiry Date" Style="{StaticResource Text.Label}"
                                               Foreground="{StaticResource Brush.MidnightTextSub}"/>
                                </Border>
                                <Border Grid.Column="1"
                                        Background="{StaticResource Brush.MidnightPropertyRight}"
                                        BorderBrush="{StaticResource Brush.MidnightBorder}"
                                        BorderThickness="0,0,0,1"
                                        Padding="8,0">
                                    <Grid>
                                        <TextBlock Text="1M"
                                                   FontFamily="{StaticResource Font.UI}"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource Brush.MidnightBlue}"
                                                   VerticalAlignment="Center"
                                                   Cursor="Hand"/>
                                        <TextBox Text="{Binding ExpiryDate, StringFormat='{}{0:dd MMM yy}'}"
                                                 Background="Transparent"
                                                 Foreground="White"
                                                 BorderThickness="0"
                                                 FontFamily="{StaticResource Font.Mono}"
                                                 FontSize="11"
                                                 FontWeight="Bold"
                                                 HorizontalAlignment="Right"
                                                 VerticalAlignment="Center"
                                                 TextAlignment="Right"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Strike -->
                            <Grid Height="28">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Background="{StaticResource Brush.MidnightPropertyLeft}"
                                        BorderBrush="{StaticResource Brush.MidnightBorder}"
                                        BorderThickness="0,0,0,1"
                                        Padding="8,0">
                                    <TextBlock Text="Strike" Style="{StaticResource Text.Label}"
                                               Foreground="{StaticResource Brush.MidnightTextSub}"/>
                                </Border>
                                <Border Grid.Column="1"
                                        Background="{StaticResource Brush.MidnightPropertyRight}"
                                        BorderBrush="{StaticResource Brush.MidnightBorder}"
                                        BorderThickness="0,0,0,1"
                                        Padding="8,0">
                                    <TextBox Text="{Binding Strike, StringFormat='{}{0:F4}'}"
                                             Background="Transparent"
                                             Foreground="{StaticResource Brush.MidnightYellow}"
                                             BorderThickness="0"
                                             FontFamily="{StaticResource Font.Mono}"
                                             FontSize="11"
                                             FontWeight="Bold"
                                             HorizontalAlignment="Right"
                                             VerticalAlignment="Center"
                                             TextAlignment="Right"/>
                                </Border>
                            </Grid>

                            </Grid>

                            <!-- Settlement -->
                            <Grid Height="28">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Background="{StaticResource Brush.MidnightPropertyLeft}"
                                        BorderBrush="{StaticResource Brush.MidnightBorder}"
                                        BorderThickness="0,0,0,1"
                                        Padding="8,0">
                                    <TextBlock Text="Settlement" Style="{StaticResource Text.Label}"
                                               Foreground="{StaticResource Brush.MidnightTextSub}"/>
                                </Border>
                                <Border Grid.Column="1"
                                        Background="{StaticResource Brush.MidnightPropertyRight}"
                                        BorderBrush="{StaticResource Brush.MidnightBorder}"
                                        BorderThickness="0,0,0,1"
                                        Padding="8,0"
                                        Cursor="Hand">
                                    <Grid>
                                        <TextBlock Text="PHYSICAL"
                                                   FontFamily="{StaticResource Font.Mono}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource Brush.MidnightTextWhite}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="▼"
                                                   FontSize="10"
                                                   Foreground="{StaticResource Brush.MidnightTextDim}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Price Display -->
                            <Grid Height="28">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>




                            </Grid>

                            <!-- Section: Market Data -->
                            <Border Background="{StaticResource Brush.MidnightBorder}"
                                    Padding="8,4"
                                    Margin="0,4,0,0"
                                    Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▶"
                                               FontSize="11"
                                               Foreground="{StaticResource Brush.MidnightTextSub}"
                                               Margin="0,0,8,0"/>
                                    <TextBlock Text="Market Data"
                                               FontFamily="{StaticResource Font.UI}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource Brush.MidnightTextWhite}"/>
                                </StackPanel>
                            </Border>

                            <!-- Section: Risk -->
                            <Border Background="{StaticResource Brush.MidnightBorder}"
                                    Padding="8,4"
                                    Margin="0,4,0,0"
                                    Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▶"
                                               FontSize="11"
                                               Foreground="{StaticResource Brush.MidnightTextSub}"
                                               Margin="0,0,8,0"/>
                                    <TextBlock Text="Risk"
                                               FontFamily="{StaticResource Font.UI}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource Brush.MidnightTextWhite}"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
