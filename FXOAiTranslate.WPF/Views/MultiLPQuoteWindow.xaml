<Window x:Class="FXOAiTranslate.WPF.Views.MultiLPQuoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="FX Option Aggregator - Multi-LP Quote"
        Height="800" Width="1100"
        MinHeight="700" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.AppBackground}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FXOAiTranslate.WPF;component/Styles/Colors.xaml"/>
                <ResourceDictionary Source="/FXOAiTranslate.WPF;component/Styles/ButtonStyles.xaml"/>
                <ResourceDictionary Source="/FXOAiTranslate.WPF;component/Styles/GridStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- ============================================ -->
    <!-- TWO-PANEL LAYOUT: PRICING LEFT | STAGING RIGHT -->
    <!-- ============================================ -->
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430" MinWidth="380"/> <!-- Left: Pricing Panel (more compact) -->
            <ColumnDefinition Width="5"/>                  <!-- Spacer -->
            <ColumnDefinition Width="*" MaxWidth="550" MinWidth="400"/>   <!-- Right: Staging Panel (constrained) -->
        </Grid.ColumnDefinitions>

        <!-- ============================================ -->
        <!-- LEFT PANEL: PRICING & EXECUTION              -->
        <!-- ============================================ -->
        <Border Grid.Column="0"
                Background="{StaticResource Brush.PanelBackground}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="3"
                Padding="15">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Action Bar -->
                    <RowDefinition Height="140"/>  <!-- Execution Tiles -->
                    <RowDefinition Height="*"/>    <!-- Quote Grid -->
                </Grid.RowDefinitions>

                <!-- ======================================== -->
                <!-- TOP BAR: Trade Description & Cancel All  -->
                <!-- ======================================== -->
                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Sell EUR Call 10.0M"
                               FontSize="9"
                               Foreground="{StaticResource Brush.TextSub}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>

                    <Button Grid.Column="1"
                            Content="CANCEL ALL"
                            Background="#FFCC0000"
                            Foreground="White"
                            FontWeight="Bold"
                            FontSize="10"
                            Height="26"
                            Width="110"
                            Cursor="Hand"
                            BorderThickness="0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="2">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <TextBlock Grid.Column="2"
                               Text="Buy EUR Call 10.0M"
                               FontSize="9"
                               Foreground="{StaticResource Brush.TextSub}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>

                <!-- ======================================== -->
                <!-- LARGE EXECUTION TILES                    -->
                <!-- ======================================== -->
                <Grid Grid.Row="1" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/> <!-- Center label -->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- BID TILE (Left - You Sell) -->
                    <Border Grid.Column="0"
                            Background="{StaticResource Brush.TileBidGradient}"
                            BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding ExecuteBidCommand}"/>
                        </Border.InputBindings>

                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- R 43 630 -->
                            <TextBlock Grid.Row="0"
                                       FontSize="10"
                                       Foreground="{StaticResource Brush.TextDim}"
                                       Margin="0,0,0,5">
                                <Run Text="43 63 pips"/>
                                <LineBreak/>
                                <Run Text="KACEJ (47s)" FontWeight="Bold"/>
                            </TextBlock>

                            <!-- Big Number -->
                            <TextBlock Grid.Row="1"
                                       Text="{Binding BestBidPremiumFormatted}"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>

                            <!-- Vol -->
                            <TextBlock Grid.Row="2"
                                       Text="{Binding BestBidVolatilityFormatted}"
                                       FontSize="12"
                                       Foreground="{StaticResource Brush.TextSub}"
                                       HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- CENTER LABEL -->
                    <TextBlock Grid.Column="1"
                               Text="RFQ&#x0a;Multibank"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{StaticResource Brush.TextDim}"
                               TextAlignment="Center"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"/>

                    <!-- OFFER TILE (Right - You Buy) -->
                    <Border Grid.Column="2"
                            Background="{StaticResource Brush.TileOfferGradient}"
                            BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding ExecuteOfferCommand}"/>
                        </Border.InputBindings>

                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- P 44 570 -->
                            <TextBlock Grid.Row="0"
                                       FontSize="10"
                                       Foreground="{StaticResource Brush.TextDim}"
                                       Margin="0,0,0,5">
                                <Run Text="+44 57 pips"/>
                                <LineBreak/>
                                <Run Text="DEUT (29s)" FontWeight="Bold"/>
                            </TextBlock>

                            <!-- Big Number -->
                            <TextBlock Grid.Row="1"
                                       Text="{Binding BestOfferPremiumFormatted}"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>

                            <!-- Vol -->
                            <TextBlock Grid.Row="2"
                                       Text="{Binding BestOfferVolatilityFormatted}"
                                       FontSize="12"
                                       Foreground="{StaticResource Brush.TextSub}"
                                       HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ======================================== -->
                <!-- CENTERED PRICING GRID (BID | BANK | OFFER) -->
                <!-- ======================================== -->
                <DataGrid Grid.Row="2"
                          ItemsSource="{Binding Quotes}"
                          Style="{StaticResource QuoteDataGrid}"
                          ColumnHeaderStyle="{StaticResource DataGridColumnHeader}"
                          RowStyle="{StaticResource QuoteDataGridRow}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          SelectionMode="Single">

                    <DataGrid.Columns>
                        <!-- BID (Left Column) -->
                        <DataGridTextColumn Header="BID (RECEIVE)"
                                            Binding="{Binding BidDisplay}"
                                            Width="2*">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeader}">
                                    <Setter Property="Background" Value="{StaticResource Brush.TealDark}"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.TextMain}"/>
                                    <Setter Property="FontSize" Value="10"/>
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Margin" Value="0,4"/>
                                    <Setter Property="LineHeight" Value="14"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- BANK NAME (Center Column) -->
                        <DataGridTextColumn Header="VENUE"
                                            Binding="{Binding BankName}"
                                            Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource BankNameCellText}">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- OFFER (Right Column) -->
                        <DataGridTextColumn Header="OFFER (PAY)"
                                            Binding="{Binding OfferDisplay}"
                                            Width="2*">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeader}">
                                    <Setter Property="Background" Value="#FF1A4A6F"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.TextMain}"/>
                                    <Setter Property="FontSize" Value="10"/>
                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                    <Setter Property="Margin" Value="0,4"/>
                                    <Setter Property="LineHeight" Value="14"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ============================================ -->
        <!-- RIGHT PANEL: TRADE STAGING (GFI STYLE)      -->
        <!-- ============================================ -->
        <ScrollViewer Grid.Column="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">

            <Border Background="{StaticResource Brush.PanelBackground}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="15">

                <StackPanel>
                    <!-- Header -->
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding TradeTitle}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource Brush.TextMain}"/>

                        <TextBlock Grid.Column="1"
                                   Text="European"
                                   FontSize="14"
                                   Foreground="{StaticResource Brush.TextSub}"
                                   VerticalAlignment="Bottom"/>
                    </Grid>

                    <!-- TRADE DETAILS SECTION (Muted Green) -->
                    <Border Background="#FF0A2520"
                            BorderBrush="#FF153530"
                            BorderThickness="1"
                            CornerRadius="2"
                            Padding="12"
                            Margin="0,0,0,10">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Row 0: strategy -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="strategy" Foreground="#FFB08860" FontSize="11" Margin="0,2"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="EUR Call" Foreground="#FFDDDDDD" FontSize="11" Margin="0,2"/>

                            <!-- Row 1: dates -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="dates" Foreground="#FFB08860" FontSize="11" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="1M NYK 14 Jan 26" Foreground="#FFDDDDDD" FontSize="11" Margin="0,2"/>

                            <!-- Row 2: maturity -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="maturity" Foreground="#FFB08860" FontSize="11" Margin="0,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="1 Month" Foreground="#FF88CCDD" FontSize="11" Margin="0,2"/>

                            <!-- Row 3: cutoff -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="cutoff" Foreground="#FFB08860" FontSize="11" Margin="0,2"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="NYK" Foreground="#FFDDDDDD" FontSize="11" Margin="0,2"/>

                            <!-- Row 4: expiry -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="expiry" Foreground="#FFB08860" FontSize="11" Margin="0,2"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="14 Jan 26" Foreground="#FFDDDDDD" FontSize="11" Margin="0,2"/>

                            <!-- Row 5: delivery -->
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="delivery" Foreground="#FFB08860" FontSize="11" Margin="0,2"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="16 Jan 26" Foreground="#FFDDDDDD" FontSize="11" Margin="0,2"/>

                            <!-- Row 6: strike -->
                            <TextBlock Grid.Row="6" Grid.Column="0" Text="strike" Foreground="#FFB08860" FontSize="11" Margin="0,2"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="1.1850" Foreground="#FF88CCDD" FontSize="11" Margin="0,2"/>

                            <!-- Row 7: delta -->
                            <TextBlock Grid.Row="7" Grid.Column="0" Text="delta" Foreground="#FFB08860" FontSize="11" Margin="0,2"/>
                            <TextBlock Grid.Row="7" Grid.Column="1" Text="+32.8%" Foreground="#FFDDDDDD" FontSize="11" Margin="0,2"/>

                            <!-- Row 8: amounts -->
                            <TextBlock Grid.Row="8" Grid.Column="0" Text="EUR amount" Foreground="#FFB08860" FontSize="11" Margin="0,2"/>
                            <TextBlock Grid.Row="8" Grid.Column="1" Text="10 000 000" Foreground="#FF88CCDD" FontSize="11" FontWeight="Bold" Margin="0,2"/>
                        </Grid>
                    </Border>

                    <!-- HEDGE SECTION (Muted Blue) -->
                    <Border Background="#FF0F1A28"
                            BorderBrush="#FF1A2A40"
                            BorderThickness="1"
                            CornerRadius="2"
                            Padding="12"
                            Margin="0,0,0,10">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="delta hedge" Foreground="#FFB08860" FontSize="11" Margin="0,2"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="None" Foreground="#FFDDDDDD" FontSize="11" Margin="0,2"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="prem type" Foreground="#FFB08860" FontSize="11" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Spot" Foreground="#FFDDDDDD" FontSize="11" Margin="0,2"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="prem date" Foreground="#FFB08860" FontSize="11" Margin="0,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="16 Dec 25" Foreground="#FFDDDDDD" FontSize="11" Margin="0,2"/>
                        </Grid>
                    </Border>

                    <!-- MARKET DATA SECTION (Muted Yellow) -->
                    <Border Background="#FF252015"
                            BorderBrush="#FF3A3020"
                            BorderThickness="1"
                            CornerRadius="2"
                            Padding="12"
                            Margin="0,0,0,10">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="spot" Foreground="#FFB08860" FontSize="11" Margin="0,2"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="1.1736/38" Foreground="#FFDDDDDD" FontSize="11" Margin="0,2"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="swap" Foreground="#FFB08860" FontSize="11" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="+19.9/+20.0" Foreground="#FFDDDDDD" FontSize="11" Margin="0,2"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="forward" Foreground="#FFB08860" FontSize="11" Margin="0,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="1.1756/58" Foreground="#FFDDDDDD" FontSize="11" Margin="0,2"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="volatility" Foreground="#FFB08860" FontSize="11" Margin="0,2"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="5.51/5.76%" Foreground="#FFDDDDDD" FontSize="11" Margin="0,2"/>
                        </Grid>
                    </Border>

                    <!-- PRICING SECTION (Muted Purple) -->
                    <Border Background="#FF201520"
                            BorderBrush="#FF352535"
                            BorderThickness="1"
                            CornerRadius="2"
                            Padding="12">

                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Content="EUR" Background="#FF352535" Foreground="#FFDDDDDD"
                                        Height="30" Margin="0,0,5,0" BorderThickness="0"/>
                                <Button Grid.Column="1" Content="USD" Background="#FF503550" Foreground="#FFDDDDDD"
                                        Height="30" Margin="5,0,0,0" BorderThickness="0"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="pts price" Foreground="#FFB08860" FontSize="11" Margin="0,2"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="-43½ pips" Foreground="#FFDDDDDD" FontSize="11" Margin="0,2"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="USD premium" Foreground="#FFB08860" FontSize="11" Margin="0,4,0,2"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="Pay 43 442" Foreground="#FFDDDDDD" FontSize="16" FontWeight="Bold" Margin="0,4,0,2"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="EUR hedge" Foreground="#FFB08860" FontSize="11" Margin="0,2"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="None" Foreground="#FFDDDDDD" FontSize="11" Margin="0,2"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="USD vega amount" Foreground="#FFB08860" FontSize="11" Margin="0,2"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="+12 700" Foreground="#FFDDDDDD" FontSize="11" Margin="0,2"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>
