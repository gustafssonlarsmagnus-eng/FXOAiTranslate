<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================ -->
    <!-- COLOR PALETTE - Darker Bloomberg Style      -->
    <!-- ============================================ -->

    <!-- Backgrounds (Darker) -->
    <SolidColorBrush x:Key="Brush.AppBackground" Color="#FF000000"/>
    <SolidColorBrush x:Key="Brush.PanelBackground" Color="#FF0A0A0A"/>
    <SolidColorBrush x:Key="Brush.HeaderBackground" Color="#FF050505"/>
    <SolidColorBrush x:Key="Brush.Border" Color="#FF1A1A1A"/>
    <SolidColorBrush x:Key="Brush.TileDark" Color="#FF121212"/>

    <!-- Accents (More Muted) -->
    <SolidColorBrush x:Key="Brush.TealMain" Color="#FF00876C"/>
    <SolidColorBrush x:Key="Brush.TealDark" Color="#FF004D3D"/>
    <SolidColorBrush x:Key="Brush.TealMuted" Color="#FF1A3A33"/>
    <SolidColorBrush x:Key="Brush.RedMain" Color="#FF870020"/>
    <SolidColorBrush x:Key="Brush.Gold" Color="#FFFFCC00"/>
    <SolidColorBrush x:Key="Brush.GreenAccent" Color="#FF00AA88"/>

    <!-- Winner highlight - just the accent bar -->
    <SolidColorBrush x:Key="Brush.WinnerAccent" Color="#FF00AA88"/>

    <!-- Typography Colors -->
    <SolidColorBrush x:Key="Brush.TextMain" Color="#FFE0E0E0"/>
    <SolidColorBrush x:Key="Brush.TextSub" Color="#FF888888"/>
    <SolidColorBrush x:Key="Brush.TextDim" Color="#FF555555"/>

    <!-- Subtle Gradients for Tiles (Much Darker) -->
    <LinearGradientBrush x:Key="Brush.TileBidGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF0A0A0A" Offset="0.0"/>
        <GradientStop Color="#FF151515" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.TileOfferGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF0A0A0A" Offset="0.0"/>
        <GradientStop Color="#FF151515" Offset="1.0"/>
    </LinearGradientBrush>

</ResourceDictionary>
