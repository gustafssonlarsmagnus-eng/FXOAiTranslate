<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- ===== DARK THEME PALETTE (From fx_aggregator_fixed_380.html) ===== -->
    
    <!-- Backgrounds (Midnight/Slate theme) -->
    <Color x:Key="ColorBackgroundMain">#0b0d10</Color>         <!-- body bg -->
    <Color x:Key="ColorBackgroundPanel">#14161b</Color>        <!-- bg-[#14161b] panels -->
    <Color x:Key="ColorBackgroundHeader">#1a1d23</Color>       <!-- bg-[#1a1d23] headers -->
    <Color x:Key="ColorBackgroundInput">#0f1114</Color>        <!-- bg-[#0f1114] inputs -->
    <Color x:Key="ColorBackgroundRow">#0f1114</Color>          <!-- ladder row default -->
    <Color x:Key="ColorBackgroundRowHover">#1e2536</Color>     <!-- ladder-row:hover -->
    <Color x:Key="ColorBorder">#1e293b</Color>                 <!-- border-[#1e293b] -->
    
    <!-- Text Colors (Slate palette, Tailwind) -->
    <Color x:Key="ColorTextPrimary">#e2e8f0</Color>            <!-- text-slate-200 -->
    <Color x:Key="ColorTextSecondary">#94a3b8</Color>          <!-- text-slate-400 -->
    <Color x:Key="ColorTextMuted">#64748b</Color>              <!-- text-slate-500 -->
    <Color x:Key="ColorTextDim">#475569</Color>                <!-- text-slate-600 -->
    <Color x:Key="ColorTextBuy">#3b82f6</Color>                <!-- text-blue-500 -->
    <Color x:Key="ColorTextSell">#ef4444</Color>               <!-- text-red-500 -->
    <Color x:Key="ColorTextCall">#22c55e</Color>               <!-- text-green-500 -->
    <Color x:Key="ColorTextPut">#ef4444</Color>                <!-- text-red-500 -->
    
    <!-- Status Colors -->
    <Color x:Key="ColorStatusFilled">#22c55e</Color>           <!-- green-500 -->
    <Color x:Key="ColorStatusRejected">#ef4444</Color>         <!-- red-500 -->
    <Color x:Key="ColorStatusNew">#f59e0b</Color>              <!-- amber-500 -->
    <Color x:Key="ColorStatusPending">#64748b</Color>          <!-- slate-500 -->
    
    <!-- Accents -->
    <Color x:Key="ColorAccentBlue">#3b82f6</Color>             <!-- blue-500 -->
    <Color x:Key="ColorAccentPurple">#8b5cf6</Color>           <!-- violet-500 -->
    <Color x:Key="ColorAccentCyan">#06b6d4</Color>             <!-- cyan-500 -->
    <Color x:Key="ColorAccentAmber">#f59e0b</Color>            <!-- amber-500 -->
    
    <!-- Best Price Highlight (Subtle navy gradient base) -->
    <Color x:Key="ColorBestPriceHighlight">#331e3a8a</Color>   <!-- rgba(30, 58, 138, 0.2) -->
    <Color x:Key="ColorBestPriceBorder">#3b82f6</Color>        <!-- blue-500 for vertical bar -->

    <!-- ===== BRUSHES ===== -->
    <SolidColorBrush x:Key="BrushBackgroundMain" Color="{StaticResource ColorBackgroundMain}"/>
    <SolidColorBrush x:Key="BrushBackgroundPanel" Color="{StaticResource ColorBackgroundPanel}"/>
    <SolidColorBrush x:Key="BrushBackgroundHeader" Color="{StaticResource ColorBackgroundHeader}"/>
    <SolidColorBrush x:Key="BrushBackgroundInput" Color="{StaticResource ColorBackgroundInput}"/>
    <SolidColorBrush x:Key="BrushBackgroundRow" Color="{StaticResource ColorBackgroundRow}"/>
    <SolidColorBrush x:Key="BrushBackgroundRowHover" Color="{StaticResource ColorBackgroundRowHover}"/>
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}"/>
    
    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}"/>
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}"/>
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}"/>
    <SolidColorBrush x:Key="BrushTextDim" Color="{StaticResource ColorTextDim}"/>
    
    <SolidColorBrush x:Key="BrushTextBuy" Color="{StaticResource ColorTextBuy}"/>
    <SolidColorBrush x:Key="BrushTextSell" Color="{StaticResource ColorTextSell}"/>
    <SolidColorBrush x:Key="BrushCall" Color="{StaticResource ColorTextCall}"/>
    <SolidColorBrush x:Key="BrushPut" Color="{StaticResource ColorTextPut}"/>
    
    <SolidColorBrush x:Key="BrushStatusFilled" Color="{StaticResource ColorStatusFilled}"/>
    <SolidColorBrush x:Key="BrushStatusRejected" Color="{StaticResource ColorStatusRejected}"/>
    <SolidColorBrush x:Key="BrushStatusNew" Color="{StaticResource ColorStatusNew}"/>

    <SolidColorBrush x:Key="BrushAccentBlue" Color="{StaticResource ColorAccentBlue}"/>
    <SolidColorBrush x:Key="BrushAccentPurple" Color="{StaticResource ColorAccentPurple}"/>
    <SolidColorBrush x:Key="BrushAccentGreen" Color="{StaticResource ColorStatusFilled}"/>
    <SolidColorBrush x:Key="BrushAccentRed" Color="{StaticResource ColorStatusRejected}"/>
    <SolidColorBrush x:Key="BrushAccentAmber" Color="{StaticResource ColorAccentAmber}"/>
    
    <!-- Legacy/Brand Specific -->
    <Color x:Key="ColorBloombergOrange">#ff8800</Color>
    <SolidColorBrush x:Key="BrushBloomberg" Color="{StaticResource ColorBloombergOrange}"/>

</ResourceDictionary>
