<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Dark Theme Palette -->
    <Color x:Key="ColorBackgroundMain">#1a1f24</Color>
    <Color x:Key="ColorBackgroundPanel">#212529</Color>
    <Color x:Key="ColorBackgroundHeader">#343a40</Color>
    <Color x:Key="ColorBackgroundInput">#2c3036</Color>
    <Color x:Key="ColorBorder">#495057</Color>
    
    <!-- Text Colors -->
    <Color x:Key="ColorTextPrimary">#e9ecef</Color>
    <Color x:Key="ColorTextSecondary">#adb5bd</Color>
    <Color x:Key="ColorTextMuted">#6c757d</Color>
    <Color x:Key="ColorTextBuy">#0d6efd</Color>  <!-- Blue -->
    <Color x:Key="ColorTextSell">#dc3545</Color> <!-- Red -->
    <Color x:Key="ColorTextCall">#198754</Color> <!-- Green -->
    <Color x:Key="ColorTextPut">#dc3545</Color>  <!-- Red -->
    
    <!-- Status Colors -->
    <Color x:Key="ColorStatusFilled">#198754</Color>    <!-- Success Green -->
    <Color x:Key="ColorStatusRejected">#dc3545</Color>  <!-- Danger Red -->
    <Color x:Key="ColorStatusNew">#ffc107</Color>       <!-- Warning Yellow -->
    <Color x:Key="ColorStatusPending">#adb5bd</Color>   <!-- Gray -->
    
    <!-- Accents -->
    <Color x:Key="ColorAccentBlue">#0d6efd</Color>
    <Color x:Key="ColorAccentPurple">#6f42c1</Color>
    <Color x:Key="ColorAccentCyan">#0dcaf0</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BrushBackgroundMain" Color="{StaticResource ColorBackgroundMain}"/>
    <SolidColorBrush x:Key="BrushBackgroundPanel" Color="{StaticResource ColorBackgroundPanel}"/>
    <SolidColorBrush x:Key="BrushBackgroundHeader" Color="{StaticResource ColorBackgroundHeader}"/>
    <SolidColorBrush x:Key="BrushBackgroundInput" Color="{StaticResource ColorBackgroundInput}"/>
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}"/>
    
    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}"/>
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}"/>
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}"/>
    
    <SolidColorBrush x:Key="BrushBuy" Color="{StaticResource ColorTextBuy}"/>
    <SolidColorBrush x:Key="BrushSell" Color="{StaticResource ColorTextSell}"/>
    <SolidColorBrush x:Key="BrushCall" Color="{StaticResource ColorTextCall}"/>
    <SolidColorBrush x:Key="BrushPut" Color="{StaticResource ColorTextPut}"/>
    
    <SolidColorBrush x:Key="BrushStatusFilled" Color="{StaticResource ColorStatusFilled}"/>
    <SolidColorBrush x:Key="BrushStatusRejected" Color="{StaticResource ColorStatusRejected}"/>
    <SolidColorBrush x:Key="BrushStatusNew" Color="{StaticResource ColorStatusNew}"/>
    
    <!-- Legacy/Brand Specific -->
    <Color x:Key="ColorBloombergOrange">#ff8800</Color>
    <SolidColorBrush x:Key="BrushBloomberg" Color="{StaticResource ColorBloombergOrange}"/>

</ResourceDictionary>
