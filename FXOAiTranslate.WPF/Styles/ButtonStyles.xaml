<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/FXOAiTranslate.WPF;component/Styles/Colors.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ============================================ -->
    <!-- EXECUTION BUTTON STYLE (Darker, More Subtle) -->
    <!-- ============================================ -->

    <Style x:Key="ExecutionButtonBorder" TargetType="Border">
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Brush.TealMain}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- BID Button (Dark with subtle gradient) -->
    <Style x:Key="BidButtonBorder" TargetType="Border" BasedOn="{StaticResource ExecutionButtonBorder}">
        <Setter Property="Background" Value="{StaticResource Brush.TileBidGradient}"/>
    </Style>

    <!-- OFFER Button (Dark with subtle gradient) -->
    <Style x:Key="OfferButtonBorder" TargetType="Border" BasedOn="{StaticResource ExecutionButtonBorder}">
        <Setter Property="Background" Value="{StaticResource Brush.TileOfferGradient}"/>
    </Style>

    <!-- Label Styles -->
    <Style x:Key="TileLabelText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSub}"/>
        <Setter Property="FontSize" Value="9"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="BigPremiumText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="36"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="VolatilityText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSub}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="BankNameText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <!-- Button Header Text (for tile labels) -->
    <Style x:Key="ButtonHeaderText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSub}"/>
    </Style>

    <!-- Bank Tag Style (small bank name badge) -->
    <Style x:Key="BankTag" TargetType="Border">
        <Setter Property="Background" Value="#FF1A1A1A"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="Padding" Value="6,2"/>
    </Style>

</ResourceDictionary>
