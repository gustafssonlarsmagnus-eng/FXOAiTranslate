<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/FXOAiTranslate.WPF;component/Styles/Colors.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ============================================ -->
    <!-- TOOLTIP STYLES - Matching HTML Mockup       -->
    <!-- ============================================ -->
    
    <Style x:Key="TradeTooltip" TargetType="ToolTip">
        <Setter Property="Background" Value="#0f1318"/>
        <Setter Property="BorderBrush" Value="#1e3a5f"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="#e2e8f0"/>
      <Setter Property="Padding" Value="12,12"/>
        <Setter Property="HasDropShadow" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
         <Border Background="{TemplateBinding Background}"
        BorderBrush="{TemplateBinding BorderBrush}"
    BorderThickness="{TemplateBinding BorderThickness}"
       CornerRadius="4"
        Padding="{TemplateBinding Padding}">
  <Border.Effect>
  <DropShadowEffect Color="Black" Direction="270" ShadowDepth="8" Opacity="0.6" BlurRadius="32"/>
</Border.Effect>
           <ContentPresenter/>
  </Border>
           </ControlTemplate>
        </Setter.Value>
        </Setter>
    </Style>

    <!-- Tooltip Section Label -->
    <Style x:Key="TooltipLabel" TargetType="TextBlock">
    <Setter Property="FontSize" Value="9"/>
   <Setter Property="Foreground" Value="#64748b"/>
        <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Margin" Value="0,0,0,3"/>
    </Style>

    <!-- Tooltip Value Text -->
    <Style x:Key="TooltipValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#e2e8f0"/>
     <Setter Property="FontWeight" Value="Medium"/>
    </Style>

    <!-- Tooltip Highlight (blue accent) -->
    <Style x:Key="TooltipHighlight" TargetType="Run">
 <Setter Property="Foreground" Value="#60a5fa"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Tooltip Divider Line -->
    <Style x:Key="TooltipDivider" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="#1e293b"/>
     <Setter Property="Margin" Value="0,8"/>
    </Style>

    <!-- ============================================ -->
    <!-- EXECUTION TILE STYLES        -->
    <!-- ============================================ -->

    <!-- Tile Style with Hover Effect -->
    <Style x:Key="ExecutionTile" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.TileGradient}"/>
 <Setter Property="BorderBrush" Value="#1e293b"/>
        <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Cursor" Value="Hand"/>
    <Style.Triggers>
   <Trigger Property="IsMouseOver" Value="True">
         <Setter Property="Background" Value="{StaticResource Brush.TileHoverGradient}"/>
   </Trigger>
        </Style.Triggers>
    </Style>

    <!-- RFQ Label Style (before quotes) -->
    <Style x:Key="RfqLabel" TargetType="TextBlock">
   <Setter Property="FontSize" Value="10"/>
     <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#64748b"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <!-- RFQ Large Text (before quotes) -->
<Style x:Key="RfqValue" TargetType="TextBlock">
      <Setter Property="FontSize" Value="72"/>
        <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="#64748b"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <!-- Live Price Value -->
    <Style x:Key="LivePriceValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="72"/>
<Setter Property="FontWeight" Value="Bold"/>
   <Setter Property="Foreground" Value="White"/>
   <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <!-- Secondary Price Info -->
    <Style x:Key="SecondaryPrice" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14"/>
  <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#64748b"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,8,0,0"/>
        <Setter Property="FontFamily" Value="JetBrains Mono, Consolas"/>
 </Style>

    <!-- LP Badge Container -->
    <Style x:Key="LPBadge" TargetType="Border">
     <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="12,4"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
     <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="Margin" Value="0"/>
    </Style>

    <!-- LP Name Text -->
  <Style x:Key="LPName" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Bold"/>
  <Setter Property="Foreground" Value="White"/>
        <Setter Property="MinWidth" Value="50"/>
    </Style>

    <!-- Countdown Text -->
    <Style x:Key="CountdownText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#f59e0b"/>
        <Setter Property="Margin" Value="8,0,0,0"/>
    </Style>

    <!-- Spread Badge -->
    <Style x:Key="SpreadBadge" TargetType="Border">
        <Setter Property="Background" Value="#0b0d10"/>
  <Setter Property="BorderBrush" Value="#1e293b"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
   <Setter Property="Padding" Value="12,4"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Bottom"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
</Style>

    <!-- Spread Value -->
    <Style x:Key="SpreadValue" TargetType="TextBlock">
<Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Bold"/>
  <Setter Property="Foreground" Value="White"/>
    </Style>

    <!-- ============================================ -->
    <!-- LADDER ROW STYLES   -->
    <!-- ============================================ -->

    <!-- Best Bid Cell -->
    <Style x:Key="BestBidCell" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Brush.BestBidBackground}"/>
    <Setter Property="BorderBrush" Value="#3b82f6"/>
<Setter Property="BorderThickness" Value="2,0,0,0"/>
    </Style>

    <!-- Best Offer Cell -->
    <Style x:Key="BestOfferCell" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.BestOfferBackground}"/>
   <Setter Property="BorderBrush" Value="#3b82f6"/>
        <Setter Property="BorderThickness" Value="0,0,2,0"/>
  </Style>

    <!-- Ladder Row (hoverable) -->
    <Style x:Key="LadderRow" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#1e2536"/>
  </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================ -->
    <!-- CONTROL BAR STYLES          -->
    <!-- ============================================ -->

    <Style x:Key="ControlBar" TargetType="Border">
<Setter Property="Background" Value="#14161b"/>
        <Setter Property="BorderBrush" Value="#1e293b"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="12,6"/>
    </Style>

    <Style x:Key="ControlBarLabel" TargetType="TextBlock">
  <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#64748b"/>
 <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="ControlBarValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#3b82f6"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ============================================ -->
    <!-- OPTION DETAILS STYLES    -->
    <!-- ============================================ -->

    <Style x:Key="OptionDetailRow" TargetType="Grid">
        <Setter Property="Height" Value="24"/>
    </Style>

    <Style x:Key="OptionDetailLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#64748b"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
     <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>

<Style x:Key="OptionDetailValue" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#e2e8f0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="OptionDetailValueBold" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Collapsible Section Header -->
    <Style x:Key="CollapsibleHeader" TargetType="Border">
        <Setter Property="Background" Value="#1e293b"/>
     <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Padding" Value="8,4"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
      <Setter Property="Background" Value="#253048"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
