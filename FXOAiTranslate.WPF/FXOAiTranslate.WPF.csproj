<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FXOptionsSimulator\FXOptionsSimulator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\Web\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\Documentation\fx_aggregator_fixed_380.html" Link="Documentation\fx_aggregator_fixed_380.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Embedded Inter Font (static versions for consistent glyph rendering) -->
  <ItemGroup>
    <Resource Include="Fonts\extras\ttf\Inter-Regular.ttf" />
    <Resource Include="Fonts\extras\ttf\Inter-Bold.ttf" />
    <Resource Include="Fonts\extras\ttf\Inter-SemiBold.ttf" />
  </ItemGroup>

</Project>
