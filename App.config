<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<connectionStrings>
		<add name="AHSKvant"
		     connectionString="Data Source=AHSKvant-prod-db;Initial Catalog=AHS;Integrated Security=True;Connect Timeout=15"
		     providerName="System.Data.SqlClient" />
	</connectionStrings>
	<appSettings>
		<add key="OpenAIApiKey" value="changeme" />
	</appSettings>
</configuration>