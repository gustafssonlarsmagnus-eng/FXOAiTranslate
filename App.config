<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<connectionStrings>
		<!-- Remote-compatible connection string:
		     - Uses TCP/IP explicitly (not Named Pipes)
		     - TrustServerCertificate for remote SSL
		  - Increased timeout for VPN latency
		     - If Integrated Security fails remotely, switch to SQL Authentication:
		   User Id=your_username;Password=your_password; -->
		<add name="AHSKvant"
		     connectionString="Server=tcp:AHSKvant-prod-db,1433;Database=AHS;Integrated Security=True;Connect Timeout=15;Encrypt=True;TrustServerCertificate=True"
		     providerName="Microsoft.Data.SqlClient" />
	</connectionStrings>
	<appSettings>
		<add key="OpenAIApiKey" value="changeme" />
	</appSettings>
</configuration>