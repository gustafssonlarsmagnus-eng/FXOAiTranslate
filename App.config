<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<connectionStrings>
		<add name="AHSKvant"
		     connectionString="Server=AHSKvant-prod-db;Database=AHS;Integrated Security=True;Connect Timeout=30;Encrypt=False"
		     providerName="System.Data.SqlClient" />
	</connectionStrings>
	<appSettings>
		<add key="OpenAIApiKey" value="changeme" />
	</appSettings>
</configuration>